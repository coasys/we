{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "paths": {
      "@models/*": ["../models/*"],
      "@helpers/*": ["../helpers/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
