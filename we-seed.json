{
  "project": {
    "name": "WE Native App",
    "version": "0.1.0",
    "description": "Pure WE application built with design system and schema renderer",
    "author": "James Weir"
  },
  "modules": [
    "call",
    "transcribe",
    "live",
    "pocket",
    "notes",
    "globe",
    "graph",
    {
      "id": "polls",
      "enabled": false
    }
  ],
  "templates": ["default", "workshop", "discord", "twitter", "instagram", "youtube", "kanban", "events", "scrapbook"],
  "views": ["about", "cards", "graph", "globe", "boards", "calendar"],
  "spaceStarters": [
    {
      "id": "we-default",
      "name": "Workshop",
      "description": "A shared canvas, a board and a calendar for what the community's calls and messages produce.",
      "settings": {
        "defaultTemplateId": "workshop",
        "defaultThemeId": "dark",
        "autoInterpret": true,
        "extractionTargets": ["TaskBlock", "EventBlock", "Relationship"],
        "taskStates": ["$todo", "$doing", "$done"]
      },
      "records": [
        {
          "$id": "like",
          "entity": "SignalType",
          "fields": {
            "name": "Like",
            "slug": "like",
            "description": "The ordinary yes — you read it and you are glad it is here.",
            "icon": "heart",
            "mode": "toggle",
            "aggregate": "count",
            "semantic": "approval",
            "rangeMin": 0,
            "rangeMax": 1
          },
          "in": null
        },
        {
          "$id": "todo",
          "entity": "TaskState",
          "fields": {
            "name": "To do",
            "slug": "todo",
            "semantic": "open"
          },
          "in": null
        },
        {
          "$id": "doing",
          "entity": "TaskState",
          "fields": {
            "name": "Doing",
            "slug": "doing",
            "semantic": "active"
          },
          "in": null
        },
        {
          "$id": "done",
          "entity": "TaskState",
          "fields": {
            "name": "Done",
            "slug": "done",
            "semantic": "done"
          },
          "in": null
        },
        {
          "$id": "involvement-assignee",
          "entity": "InvolvementType",
          "fields": {
            "name": "Assigned",
            "slug": "assignee",
            "semantic": "responsible",
            "reflexive": false,
            "appliesTo": "TaskBlock",
            "icon": "user-circle-check"
          },
          "in": null
        },
        {
          "$id": "involvement-reviewer",
          "entity": "InvolvementType",
          "fields": {
            "name": "Reviewing",
            "slug": "reviewer",
            "semantic": "reviewing",
            "reflexive": false,
            "appliesTo": "TaskBlock",
            "icon": "eye"
          },
          "in": null
        },
        {
          "$id": "involvement-going",
          "entity": "InvolvementType",
          "fields": {
            "name": "Going",
            "slug": "going",
            "semantic": "committed",
            "reflexive": true,
            "appliesTo": "EventBlock",
            "icon": "check-circle"
          },
          "in": null
        },
        {
          "$id": "involvement-maybe",
          "entity": "InvolvementType",
          "fields": {
            "name": "Maybe",
            "slug": "maybe",
            "semantic": "interested",
            "reflexive": true,
            "appliesTo": "EventBlock",
            "icon": "question"
          },
          "in": null
        },
        {
          "$id": "involvement-not-going",
          "entity": "InvolvementType",
          "fields": {
            "name": "Not going",
            "slug": "not-going",
            "semantic": "declined",
            "reflexive": true,
            "appliesTo": "EventBlock",
            "icon": "x-circle"
          },
          "in": null
        },
        {
          "$id": "canvas",
          "entity": "CollectionBlock",
          "fields": {
            "kind": "canvas",
            "title": "Canvas"
          },
          "in": "$root"
        }
      ],
      "roles": {
        "canvas": "$canvas"
      },
      "input": true
    }
  ],
  "settings": {
    "globe": {
      "imagery": "ion",
      "ionAccessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJub25jZSI6Im01MDBjRTVZclBWTmwycGsiLCJqdGkiOiI3NGFjZmI5MS01MDAwLTQwZTktOTlkMC01OTJkN2E2MmQ5OTgiLCJpZCI6MjU5LCJzdWIiOiJDZXNpdW1KUyIsImlzcyI6Imh0dHBzOi8vYXBpLmNlc2l1bS5jb20iLCJhdWQiOiIxLjE0NiBSZWxlYXNlIC0gRGVsZXRlIG9uIERlY2VtYmVyIDEsIDIwMjYiLCJpYXQiOjE3OTAzMTMyMTJ9.4CskcFdVNW5VgLW2iBnYt2GIW2Yl9Q5u6T8gSRK4rkU"
    }
  },
  "ad4m": {
    "dataPath": "~/.ad4m",
    "executorPath": "../ad4m/target/release/ad4m-executor",
    "repoPath": "../ad4m"
  },
