{
  "project": {
    "name": "Flux Launcher",
    "version": "0.1.0",
    "description": "Single-app launcher with Flux",
    "author": "James Weir"
  },

  "ad4m": {
    "dataPath": "~/.we-flux",
    "executorPath": "../ad4m/target/release/ad4m-executor",
    "repoPath": "../ad4m"
  },

  "electron": {
    "appDistPath": "dist",
    "basePort": 8080
  },

  "apps": [
    {
      "id": "flux",
      "name": "Flux",
      "route": "/",
      "icon": "camera",
      "description": "AI video generation app",
      "capabilities": ["perspectives", "languages", "agents"],
      "permissions": {
        "camera": true,
        "microphone": true,
        "displayCapture": true
      },
      "paths": {
        "projectRoot": "../flux/app",
        "dist": "../flux/app/dist",
        "devServer": {
          "port": 3030,
          "host": "localhost"
        }
      },
      "commands": {
        "install": "yarn install",
        "build": "yarn build",
        "dev": "yarn dev"
      }
    }
  ]
}
