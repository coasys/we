{
  "@context": {
    "@version": 1.1,
    "op": "https://we.example/ns/operations#",
    "@vocab": "https://we.example/ns/operations#",
    "sh": "http://www.w3.org/ns/shacl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "param": "https://we.example/ns/operations/param/",
    "version": "op:version",
    "entities": { "@id": "op:entities", "@type": "@json" },
    "operations": { "@id": "op:operation", "@container": "@index", "@index": "name" },
    "name": "op:name",
    "description": "op:description",
    "params": {
      "@id": "op:param",
      "@container": "@index",
      "@index": "path",
      "@context": {
        "@base": "https://we.example/ns/operations/param/",
        "type": {
          "@id": "sh:datatype",
          "@type": "@vocab",
          "@context": {
            "string": "xsd:string",
            "number": "xsd:double",
            "boolean": "xsd:boolean",
            "json": "rdf:JSON",
            "list": "op:list",
            "object": "op:object"
          }
        },
        "minCount": "sh:minCount",
        "description": "sh:description"
      }
    },
    "path": { "@id": "sh:path", "@type": "@id" },
    "errors": { "@id": "op:errors", "@container": "@index", "@index": "code" },
    "code": "op:code",
    "message": "op:message",
    "steps": { "@id": "op:steps", "@container": "@list" },
    "returns": { "@id": "op:returns", "@type": "@json" },
    "serial": { "@id": "op:serial", "@type": "@json" },
    "find": "op:find",
    "create": "op:create",
    "update": "op:update",
    "delete": "op:delete",
    "link": "op:link",
    "unlink": "op:unlink",
    "setRelation": "op:setRelation",
    "forEach": "op:forEach",
    "check": "op:check",
    "call": "op:call",
    "when": { "@id": "op:when", "@type": "@json" },
    "as": "op:as",
    "entity": "op:entity",
    "oneOf": { "@id": "op:oneOf", "@container": "@list" },
    "category": { "@id": "op:category", "@type": "@vocab" },
    "relation": "op:relation",
    "via": "op:via",
    "anchor": "op:anchor",
    "identity": { "@id": "op:identity", "@container": "@list" },
    "unset": { "@id": "op:unset", "@container": "@list" },
    "$": "op:expression",
    "fields": { "@id": "op:fields", "@type": "@json" },
    "where": { "@id": "op:where", "@type": "@json" },
    "order": { "@id": "op:order", "@type": "@json" },
    "limit": { "@id": "op:limit", "@type": "@json" },
    "scope": "op:scope",
    "anchorId": { "@id": "op:anchorId", "@type": "@json" },
    "levels": { "@id": "op:levels", "@type": "@json" },
    "transitive": { "@id": "op:transitive", "@type": "@json" },
    "one": { "@id": "op:one", "@type": "@json" },
    "expect": { "@id": "op:expect", "@type": "@json" },
    "parent": "op:parent",
    "id": { "@id": "op:id", "@type": "@json" },
    "own": { "@id": "op:own", "@type": "@json" },
    "target": { "@id": "op:target", "@type": "@json" },
    "targets": { "@id": "op:targets", "@type": "@json" },
    "strict": { "@id": "op:strict", "@type": "@json" },
    "keep": { "@id": "op:keep", "@type": "@json" },
    "in": { "@id": "op:in", "@type": "@json" },
    "key": { "@id": "op:key", "@type": "@json" },
    "condition": { "@id": "op:condition", "@type": "@json" },
    "error": "op:error",
    "operation": "op:calls",
    "args": { "@id": "op:args", "@type": "@json" }
  }
}
