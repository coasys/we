<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app leaves the phone by backup or device transfer (Android 12 and later; older
     versions are covered by allowBackup="false"). The WebView profile holds the executor session. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
