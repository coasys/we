<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: this file replaces src/main/res/xml/network_security_config.xml in the debug
  variant, and a release build never sees it.

  It allows cleartext to the phone's own loopback and nothing else. That is how an emulator, or a
  phone on USB, reaches an executor on the development machine: `adb reverse tcp:12600 tcp:12600`,
  then http://127.0.0.1:12600 in ad4m-connect's URL field. Every other host is still https/wss only,
  as in release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
