<?xml version="1.0" encoding="utf-8"?>
<!--
  No cleartext, and no extra trust anchors. The WebView loads only its bundled files; the desktop
  connection is TLS done by the Rust plugin, which trusts the pinned key and nothing in this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
