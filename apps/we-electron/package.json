{
  "name": "@we/app-electron",
  "version": "0.1.0-alpha.1",
  "description": "WE - Decentralized social launcher (Electron)",
  "homepage": "https://github.com/jhweir/we",
  "author": {
    "name": "James Weir",
    "email": "james@weco.io"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.cjs",
    "dev": "vite",
    "prebuild:steps": "node scripts/generate-seed-config.cjs",
    "build:steps": "vite build",
    "build": "we-build",
    "serve": "vite preview",
    "preelectron:dev": "node scripts/generate-seed-config.cjs",
    "electron:dev": "node scripts/ensure-electron.cjs && node ../../scripts/ad4m-executor.mjs --soft && concurrently \"vite\" \"wait-on http://localhost:3002 && VITE_DEV_SERVER_URL=http://localhost:3002 electron electron/main.js\"",
    "preelectron:build": "node scripts/generate-seed-config.cjs && node ../../scripts/ad4m-executor.mjs",
    "electron:build": "vite build && electron-builder --config electron-builder.config.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "main": "electron/main.js",
  "dependencies": {
    "electron-context-menu": "^5.1.0",
    "express": "^5.3.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@coasys/ad4m": "*",
    "@types/node": "^26.6.6",
    "@we/app-shell": "workspace:*",
    "@we/backend-ad4m": "workspace:*",
    "@we/brand": "workspace:*",
    "@we/cli": "workspace:*",
    "@we/csp": "workspace:*",
    "@we/globe-layers": "workspace:*",
    "@we/globe-widget": "workspace:*",
    "concurrently": "^10.0.6",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "solid-js": "^1.9.17",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "desktopName": "io.weco.we.electron.desktop"
}
