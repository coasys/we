{
  "name": "@we/app-tauri",
  "version": "0.1.0-alpha.1",
  "description": "WE - Decentralized social launcher (Tauri)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "prebuild:steps": "node scripts/generate-seed-config.cjs",
    "build:steps": "vite build && vite build -c vite.identity.config.ts",
    "build": "we-build",
    "serve": "vite preview",
    "tauri": "tauri",
    "pretauri:dev": "node scripts/generate-seed-config.cjs",
    "tauri:dev": "concurrently \"pnpm dev\" \"wait-on http://localhost:1420 && tauri dev --config src-tauri/tauri.seed.conf.json --features devtools -- --release\"",
    "pretauri:build": "node scripts/generate-seed-config.cjs",
    "tauri:build": "tauri build --config src-tauri/tauri.seed.conf.json && node scripts/rename-bundle.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run identity scripts"
  },
  "dependencies": {
    "@coasys/ad4m": "*",
    "@tauri-apps/api": "2.12.4",
    "@we/app-shell": "workspace:*",
    "solid-js": "^1.9.17",
    "@we/backend-ad4m": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/three": "^0.185.4",
    "@we/brand": "workspace:*",
    "@we/cli": "workspace:*",
    "@we/csp": "workspace:*",
    "@we/globe-layers": "workspace:*",
    "@we/globe-widget": "workspace:*",
    "concurrently": "^10.0.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
