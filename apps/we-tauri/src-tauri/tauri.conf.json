{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "we-ad4m-launcher",
  "version": "0.1.0",
  "identifier": "com.james.tauri-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "we-ad4m-launcher",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../../../flux/app/dist": "flux"
    },
    "linux": {
      "appimage": {
        "files": {
          "usr/share/icons/hicolor/512x512/apps/we-ad4m-launcher.png": "icons/128x128@2x.png"
        }
      }
    }
  }
}
