[package]
name = "we-ad4m-launcher"
version = "0.1.0"
description = "WE AD4M Launcher"
authors = ["James Weir"]
edition = "2021"

[lib]
name = "app_lib"
crate-type = ["staticlib", "rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = ["devtools"] }
tauri-plugin-opener = "2"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
# AD4M paths auto-generated from we-seed.json
# To update: modify we-seed.json ad4m.repoPath, then run: node scripts/generate-seed-config.cjs
ad4m-client = { path = "{{AD4M_CLIENT_PATH}}" }
tokio = { version = "1", features = ["full"] }
warp = "0.3"
ad4m-executor = { path = "{{AD4M_EXECUTOR_PATH}}" }
uuid = { version = "0.8", features = ["v4"] }
dirs = "5"
