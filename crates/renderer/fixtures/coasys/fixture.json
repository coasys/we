      "id": "coasys-utt-105",
      "entity": "TextBlock",
      "author": "did:agent:mara",
      "createdAt": "2025-10-06T15:05:00.000Z",
      "fields": { "text": "Ten o'clock then — I'll put it in the brief.", "source": "spoken" }
    },
