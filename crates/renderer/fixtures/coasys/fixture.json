  "workflows": [
    {
      "definition": {
        "name": "pilot",
        "entities": ["TaskBlock"],
        "hint": "The October pilot pipeline — a task moves draft, active, shipped.",
        "states": [
          { "name": "draft", "hint": "Being written; not yet ready to act on." },
          { "name": "active", "hint": "Somebody is doing this now." },
          { "name": "shipped", "hint": "Done and delivered." }
        ],
        "transitions": [
          { "from": "draft", "to": "active", "name": "Start" },
          { "from": "active", "to": "shipped", "name": "Ship it" },
          { "from": "active", "to": "draft", "name": "Send back" }
        ]
      },
      "runs": [
        { "record": "coasys-task-brief", "at": "draft" },
        { "record": "coasys-task-venue", "at": "active" },
        { "record": "coasys-task-invites", "at": "shipped" }
      ]
    },
    {
      "definition": {
        "name": "review",
        "entities": [],
        "hint": "A lightweight look-over for anything in the space.",
        "states": [
          { "name": "queued", "hint": "Waiting for a reviewer." },
          { "name": "inreview", "hint": "Somebody is looking at it now." },
          { "name": "cleared", "hint": "Reviewed and cleared." }
        ],
        "transitions": [
          { "from": "queued", "to": "inreview", "name": "Pick up" },
          { "from": "inreview", "to": "cleared", "name": "Clear" },
          { "from": "inreview", "to": "queued", "name": "Hand back" }
        ]
      },
      "runs": [
        { "record": "coasys-task-survey", "at": "inreview" },
        { "record": "coasys-post-welcome", "at": "cleared" }
      ]
    }
  ]
}
