    },
    {
      "id": "coasys-dmsg-002",
      "entity": "TextBlock",
      "author": "did:agent:devon",
      "createdAt": "2025-10-01T08:21:00.000Z",
      "fields": { "text": "The accent gradient reads a bit cold on the calls list. Warmer?", "source": "typed" }
    },
    {
      "id": "coasys-dmsg-003",
      "entity": "TextBlock",
      "author": "did:agent:juni",
      "createdAt": "2025-10-01T08:24:00.000Z",
      "fields": {
        "text": "Agreed — I shifted the mid tone two steps and it sits better against the dark surfaces.",
        "source": "typed"
      }
    },
    {
      "id": "coasys-dmsg-004",
      "entity": "TextBlock",
      "author": "did:agent:mara",
      "createdAt": "2025-10-02T16:03:00.000Z",
      "fields": { "text": "Nico approved the new palette for the pilot — ship it.", "source": "typed" }
    },
    {
      "id": "coasys-dmsg-005",
      "entity": "TextBlock",
      "author": "did:agent:juni",
      "createdAt": "2025-10-03T10:40:00.000Z",
      "fields": {
        "text": "Glow is now the default theme for the space. Anything that looks wrong, drop a note here.",
        "source": "typed"
      },
      "relations": { "signals": ["coasys-sig-001", "coasys-sig-002"] }
    },
    {
      "id": "coasys-dmsg-006",
      "entity": "TextBlock",
      "author": "did:agent:sana",
      "createdAt": "2025-10-03T11:02:00.000Z",
      "fields": { "text": "Looks great! The call cards especially.", "source": "typed" }
