      "id": "coasys-utt-102",
      "entity": "TextBlock",
      "author": "did:agent:devon",
      "createdAt": "2025-10-06T15:01:15.000Z",
      "fields": { "text": "Agreed. Venue is close, Riverside's annex is the right size.", "source": "spoken" }
