      "id": "coasys-utt-202",
      "entity": "TextBlock",
      "author": "did:agent:devon",
      "createdAt": "2025-10-02T14:03:45.000Z",
      "fields": {
        "text": "Contrast on the active states is fine now; muted text is still a touch dim.",
        "source": "spoken"
      }
    },
    {
      "id": "coasys-utt-203",
      "entity": "TextBlock",
      "author": "did:agent:juni",
      "createdAt": "2025-10-02T14:05:12.000Z",
      "fields": {
        "text": "I'll lift muted a step and keep faint as is. Good enough for the pilot.",
        "source": "spoken"
      }
    },
    {
      "id": "coasys-utt-204",
      "entity": "TextBlock",
      "author": "did:agent:mara",
      "createdAt": "2025-10-02T14:06:30.000Z",
      "fields": { "text": "Ship it — and thank you both for the quick turnaround.", "source": "spoken" }
