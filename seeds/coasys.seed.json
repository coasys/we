{
  "project": {
    "name": "Coasys",
    "version": "0.1.0",
    "description": "The Coasys app: WE, whitelabelled by the Coasys cartridge",
    "author": "Coasys"
  },
  "desktop": {
    "productName": "Coasys",
    "appId": "io.coasys.app",
    "icon": "packages/templates/cartridges/src/coasys/assets/icon.svg"
  },
  "bundles": ["coasys"],
  "contentSecurity": {
    "images": ["https://coasys.org"],
    "media": ["https://coasys.org"]
  },
  "modules": ["call", "transcribe", "feed", "live", "graph"],
  "templates": ["default", "workshop"],
  "views": ["about", "cards", "graph", "boards", "calendar"],
  "spaceStarters": [
    {
      "id": "coasys-default",
      "name": "Coasys space",
      "description": "Channels, calls and the work that comes out of them, laid out as one tree and one view.",
      "settings": {
        "defaultTemplateId": "coasys--space",
        "defaultThemeId": "coasys--glow",
        "autoInterpret": true,
        "extractionTargets": ["TaskBlock", "EventBlock", "Relationship"],
        "taskStates": ["$todo", "$doing", "$done"]
      },
      "records": [
        {
          "entity": "SignalType",
          "fields": {
            "name": "Like",
            "slug": "like",
            "description": "The ordinary yes — you read it and you are glad it is here.",
            "icon": "heart",
            "mode": "toggle",
            "aggregate": "count",
            "semantic": "approval",
            "rangeMin": 0,
            "rangeMax": 1
          }
        },
        {
          "$id": "todo",
          "entity": "TaskState",
          "fields": {
            "name": "To do",
            "slug": "todo",
            "semantic": "open"
          }
        },
        {
          "$id": "doing",
          "entity": "TaskState",
          "fields": {
            "name": "Doing",
            "slug": "doing",
            "semantic": "active"
          }
        },
        {
          "$id": "done",
          "entity": "TaskState",
          "fields": {
            "name": "Done",
            "slug": "done",
            "semantic": "done"
          }
        },
        {
          "entity": "InvolvementType",
          "fields": {
            "name": "Assigned",
            "slug": "assignee",
            "semantic": "responsible",
            "reflexive": false,
            "appliesTo": "TaskBlock",
            "icon": "user-circle-check"
          }
        },
        {
          "entity": "InvolvementType",
          "fields": {
            "name": "Reviewing",
            "slug": "reviewer",
            "semantic": "reviewing",
            "reflexive": false,
            "appliesTo": "TaskBlock",
            "icon": "eye"
          }
        },
        {
          "entity": "InvolvementType",
          "fields": {
            "name": "Going",
            "slug": "going",
            "semantic": "committed",
            "reflexive": true,
            "appliesTo": "EventBlock",
            "icon": "check-circle"
          }
        },
        {
          "entity": "InvolvementType",
          "fields": {
            "name": "Maybe",
            "slug": "maybe",
            "semantic": "interested",
            "reflexive": true,
            "appliesTo": "EventBlock",
            "icon": "question"
          }
        },
        {
          "entity": "InvolvementType",
          "fields": {
            "name": "Not going",
            "slug": "not-going",
            "semantic": "declined",
            "reflexive": true,
            "appliesTo": "EventBlock",
            "icon": "x-circle"
          }
        },
        {
          "$id": "canvas",
          "entity": "CollectionBlock",
          "fields": {
            "kind": "canvas",
            "title": "Canvas"
          },
          "in": "$root"
        },
        {
          "$id": "board",
          "entity": "CollectionBlock",
          "fields": {
            "kind": "board",
            "mode": "feed",
            "title": "Everything",
            "gathers": ["$root"]
          },
          "in": "$root"
        },
        {
          "entity": "CollectionBlock",
          "fields": {
            "kind": "column",
            "mode": "feed",
            "title": "",
            "slug": "todo"
          },
          "in": "$board"
        },
        {
          "entity": "CollectionBlock",
          "fields": {
            "kind": "column",
            "mode": "feed",
            "title": "",
            "slug": "doing"
          },
          "in": "$board"
        },
        {
          "entity": "CollectionBlock",
          "fields": {
            "kind": "column",
            "mode": "feed",
            "title": "",
            "slug": "done"
          },
          "in": "$board"
        }
      ],
      "roles": {
        "canvas": "$canvas",
        "board": "$board"
      },
      "input": true
    }
  ],
  "ad4m": {
    "dataPath": "~/.coasys",
    "repoPath": "../ad4m"
  },
  "electron": {
    "appDistPath": "dist",
    "basePort": 8080
  },
  "apps": []
}
