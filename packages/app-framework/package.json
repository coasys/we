      "import": "./dist/shared/*.js",
      "types": "./dist/shared/*.d.ts"
    },
    "./solid": {
      "import": "./src/frameworks/solid/index.ts",
      "types": "./src/frameworks/solid/index.ts"
    },
    "./seed": {
      "import": "./dist/seed/index.js",
      "types": "./dist/seed/index.d.ts"
    }
  },
  "dependencies": {
    "@we/cesium-layers": "workspace:*",
    "@we/components": "workspace:*",
    "@we/design-system-types": "workspace:*",
    "@we/primitives": "workspace:*",
    "@we/models": "workspace:*",
    "@we/pages": "workspace:*",
    "@we/schema-renderer": "workspace:*",
    "@we/templates": "workspace:*",
    "@we/themes": "workspace:*",
    "@we/tokens": "workspace:*",
    "@we/widgets": "workspace:*",
    "@we/block-composer-solid": "workspace:*",
    "@coasys/ad4m": "0.11.0",
    "@solidjs/router": "^0.15.3",
    "gsap": "^3.13.0",
    "solid-js": "^1.9.5",
    "three": "^0.176.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.176.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@we/cli": "workspace:*",
    "tsup": "^8.5.1",
    "vitest": "^4.0.15"
  }
}
