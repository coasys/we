{
  "name": "@we/app-framework",
  "version": "0.1.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "bin": {
    "we-seed": "./dist/seed/cli.js"
  },
  "exports": {
