{
  "name": "@we/agent-tools",
  "version": "0.1.0",
  "description": "What a language model can do with WE — tools, their handlers and the edit loop — framework-free, for the editor and for any host that runs an agent",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "test:deno": "tsx scripts/deno-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "import": "./dist/agent-tools.bundle.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@we/ai-context": "workspace:*",
    "@we/backend-shared": "workspace:*",
    "@we/entities": "workspace:*",
    "@we/schema-shared": "workspace:*",
    "@we/themes": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@we/cli": "workspace:*",
    "@we/template-showcase": "workspace:*",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "sideEffects": false
}
