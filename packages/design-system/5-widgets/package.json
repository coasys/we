{
  "name": "@we/widgets",
  "version": "0.1.0",
  "description": "Widget components for WE",
  "author": "James Weir",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:css": "sass src/styles/index.scss dist/styles/index.css --no-source-map --style=compressed",
    "build:steps": "tsup && pnpm build:css",
    "build": "we-build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./styles": {
      "default": "./dist/styles/index.css"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@we/design-utils": "workspace:*"
  },
  "peerDependencies": {
    "@we/primitives": "^0.1.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@we/cli": "workspace:*",
    "@we/primitives": "workspace:*",
    "esbuild-plugin-solid": "^0.6.0",
    "sass": "^1.103.1",
    "solid-js": "^1.9.15",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "context": {
    "type": "widgets"
  },
  "sideEffects": [
    "*.css"
  ]
}
