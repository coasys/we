  --we-color-neutral-200: oklch(var(--we-color-lightness-200) calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-200), 1 - var(--we-color-lightness-200)))) var(--we-color-neutral-hue));
  --we-color-neutral-300: oklch(var(--we-color-lightness-300) calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-300), 1 - var(--we-color-lightness-300)))) var(--we-color-neutral-hue));
  --we-color-neutral-400: oklch(var(--we-color-lightness-400) calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-400), 1 - var(--we-color-lightness-400)))) var(--we-color-neutral-hue));
  --we-color-neutral-500: oklch(var(--we-color-lightness-500) calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-500), 1 - var(--we-color-lightness-500)))) var(--we-color-neutral-hue));
  --we-color-neutral-600: oklch(var(--we-color-lightness-600) calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-600), 1 - var(--we-color-lightness-600)))) var(--we-color-neutral-hue));
