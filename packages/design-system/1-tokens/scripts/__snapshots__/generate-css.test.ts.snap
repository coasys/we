}"
`;

exports[`token CSS generation > font.css — families, sizes, weights, line heights, letter spacing 1`] = `
"/* FONT TOKENS - Generated from JS tokens */

:root {
  /* Font Family Palette */
  --we-font-family-base: 'DM Sans', sans-serif;
  --we-font-family-mozilla: 'Mozilla Text', serif;
  --we-font-family-boldonse: 'Boldonse', serif;
  --we-font-family-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;

  /* Active font family — used by all components; themes can override this */
  --we-font-family: var(--we-font-family-base);

  /* Active code face. Read by we-code, we-markdown and we-html, all of which asked for it long
     before anything declared it. */
  --we-font-mono: var(--we-font-family-mono);

  /* Font Sizes */
  --we-font-base-size: 16px;
  --we-font-size-100: 0.75rem;
  --we-font-size-200: 0.875rem;
  --we-font-size-300: 1rem;
  --we-font-size-400: 1.125rem;
  --we-font-size-500: 1.25rem;
  --we-font-size-600: 1.5rem;
  --we-font-size-700: 2rem;
  --we-font-size-800: 2.5rem;
  --we-font-size-900: 3.5rem;
  --we-font-size-1000: 4.5rem;

  /* Font Weights */
  --we-font-weight-100: 100;
  --we-font-weight-200: 200;
  --we-font-weight-300: 300;
  --we-font-weight-400: 400;
  --we-font-weight-500: 500;
  --we-font-weight-600: 600;
  --we-font-weight-700: 700;
  --we-font-weight-800: 800;
  --we-font-weight-900: 900;
  --we-font-weight-regular: 400;
  --we-font-weight-medium: 500;
  --we-font-weight-semibold: 600;
  --we-font-weight-bold: 700;

  /* Line Heights */
  --we-line-height-none: 1;
  --we-line-height-tight: 1.25;
  --we-line-height-snug: 1.375;
  --we-line-height-normal: 1.5;
  --we-line-height-relaxed: 1.625;
  --we-line-height-loose: 2;

  /* Letter Spacing */
  --we-letter-spacing-tighter: -0.05em;
  --we-letter-spacing-tight: -0.025em;
  --we-letter-spacing-normal: 0;
  --we-letter-spacing-wide: 0.025em;
  --we-letter-spacing-wider: 0.05em;
  --we-letter-spacing-widest: 0.1em;
}"
`;

