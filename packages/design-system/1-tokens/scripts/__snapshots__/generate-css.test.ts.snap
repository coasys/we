:root {
  /* Spacing Values */
  --we-space-0: 0rem;
  --we-space-100: calc(0.25rem * var(--we-theme-spacing-scale, 1) * var(--we-theme-scoped-font-scale, 1));
  --we-space-200: calc(0.5rem * var(--we-theme-spacing-scale, 1) * var(--we-theme-scoped-font-scale, 1));
  --we-space-300: calc(0.75rem * var(--we-theme-spacing-scale, 1) * var(--we-theme-scoped-font-scale, 1));
  --we-space-400: calc(1rem * var(--we-theme-spacing-scale, 1) * var(--we-theme-scoped-font-scale, 1));
  --we-space-500: calc(1.5rem * var(--we-theme-spacing-scale, 1) * var(--we-theme-scoped-font-scale, 1));
  --we-space-600: calc(2rem * var(--we-theme-spacing-scale, 1) * var(--we-theme-scoped-font-scale, 1));
  --we-space-700: calc(2.5rem * var(--we-theme-spacing-scale, 1) * var(--we-theme-scoped-font-scale, 1));
  --we-space-800: calc(3rem * var(--we-theme-spacing-scale, 1) * var(--we-theme-scoped-font-scale, 1));
  --we-space-900: calc(4rem * var(--we-theme-spacing-scale, 1) * var(--we-theme-scoped-font-scale, 1));
  --we-space-1000: calc(6rem * var(--we-theme-spacing-scale, 1) * var(--we-theme-scoped-font-scale, 1));
}"
