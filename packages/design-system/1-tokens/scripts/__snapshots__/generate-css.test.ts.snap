exports[`token CSS generation > color.css — hues, lightness ramp, palettes, roles, gradient 1`] = `
"/* COLOR TOKENS - Generated from JS tokens */

:root {
  /* Color System Configuration */
  --we-color-multiplier: 1;
  --we-color-subtractor: 0%;
  --we-color-saturation: 60%;
  --we-color-neutral-saturation: 10%;

  /* Color Hues */
  --we-color-neutral-hue: var(--we-color-primary-hue);
  --we-color-primary-hue: 250;
  --we-color-success-hue: 130;
  --we-color-warning-hue: 45;
  --we-color-danger-hue: 350;

  /* Lightness Scale */
  --we-color-lightness-0: calc((100% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-25: calc((97.5% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-50: calc((95% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-75: calc((92.5% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-100: calc((90% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-200: calc((80% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-300: calc((70% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-400: calc((60% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-500: calc((50% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-600: calc((40% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-700: calc((30% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-800: calc((20% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-900: calc((10% - var(--we-color-subtractor)) * var(--we-color-multiplier));
  --we-color-lightness-1000: calc((0% - var(--we-color-subtractor)) * var(--we-color-multiplier));

  /* Neutral Colors */
  --we-color-neutral-0: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-0));
  --we-color-neutral-25: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-25));
  --we-color-neutral-50: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-50));
  --we-color-neutral-75: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-75));
  --we-color-neutral-100: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-100));
  --we-color-neutral-200: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-200));
  --we-color-neutral-300: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-300));
  --we-color-neutral-400: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-400));
  --we-color-neutral-500: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-500));
  --we-color-neutral-600: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-600));
  --we-color-neutral-700: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-700));
  --we-color-neutral-800: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-800));
  --we-color-neutral-900: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-900));
  --we-color-neutral-1000: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-1000));

  /* Primary Colors */
  --we-color-primary-0: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-0));
  --we-color-primary-25: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-25));
  --we-color-primary-50: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-50));
  --we-color-primary-75: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-75));
  --we-color-primary-100: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-100));
  --we-color-primary-200: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-200));
  --we-color-primary-300: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-300));
  --we-color-primary-400: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-400));
  --we-color-primary-500: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-500));
  --we-color-primary-600: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-600));
  --we-color-primary-700: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-700));
  --we-color-primary-800: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-800));
  --we-color-primary-900: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-900));
  --we-color-primary-1000: hsl(var(--we-color-primary-hue) var(--we-color-saturation) var(--we-color-lightness-1000));

  /* Success Colors */
  --we-color-success-0: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-0));
  --we-color-success-25: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-25));
  --we-color-success-50: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-50));
  --we-color-success-75: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-75));
  --we-color-success-100: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-100));
  --we-color-success-200: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-200));
  --we-color-success-300: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-300));
  --we-color-success-400: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-400));
  --we-color-success-500: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-500));
  --we-color-success-600: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-600));
  --we-color-success-700: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-700));
  --we-color-success-800: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-800));
  --we-color-success-900: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-900));
  --we-color-success-1000: hsl(var(--we-color-success-hue) var(--we-color-saturation) var(--we-color-lightness-1000));

  /* Warning Colors */
  --we-color-warning-0: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-0));
  --we-color-warning-25: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-25));
  --we-color-warning-50: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-50));
  --we-color-warning-75: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-75));
  --we-color-warning-100: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-100));
  --we-color-warning-200: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-200));
  --we-color-warning-300: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-300));
  --we-color-warning-400: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-400));
  --we-color-warning-500: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-500));
  --we-color-warning-600: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-600));
  --we-color-warning-700: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-700));
  --we-color-warning-800: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-800));
  --we-color-warning-900: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-900));
  --we-color-warning-1000: hsl(var(--we-color-warning-hue) var(--we-color-saturation) var(--we-color-lightness-1000));

  /* Danger Colors */
  --we-color-danger-0: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-0));
  --we-color-danger-25: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-25));
  --we-color-danger-50: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-50));
  --we-color-danger-75: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-75));
  --we-color-danger-100: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-100));
  --we-color-danger-200: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-200));
  --we-color-danger-300: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-300));
  --we-color-danger-400: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-400));
  --we-color-danger-500: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-500));
  --we-color-danger-600: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-600));
  --we-color-danger-700: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-700));
  --we-color-danger-800: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-800));
  --we-color-danger-900: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-900));
  --we-color-danger-1000: hsl(var(--we-color-danger-hue) var(--we-color-saturation) var(--we-color-lightness-1000));

  /* Base Colors */
  --we-color-white: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-0));
  --we-color-black: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) var(--we-color-lightness-1000));

  /* Semantic Roles — intent over scale position. Defaults are parametric expressions
     so every theme keeps working untouched; themes may pin individual roles
     (ThemeOverrides.roles in @we/themes → --we-role-*). */
  --we-role-page: var(--we-color-neutral-50);
  --we-role-surface: oklch(from var(--we-role-page) calc(l + 0.045) c h);
  --we-role-surface-raised: oklch(from var(--we-role-page) calc(l + 0.1) c h);
  --we-role-surface-sunken: oklch(from var(--we-role-page) calc(l - 0.035) c h);
  --we-role-text: var(--we-color-neutral-900);
  --we-role-text-muted: var(--we-color-neutral-600);
  --we-role-text-faint: var(--we-color-neutral-400);
  --we-role-on-inverse: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) 98%);
  --we-role-surface-inverse: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) 13%);
  --we-role-border: var(--we-color-neutral-200);
  --we-role-border-strong: var(--we-color-neutral-500);
  --we-role-accent: var(--we-color-primary-500);
  --we-role-on-accent: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) 98%);
  --we-role-accent-muted: var(--we-color-primary-100);
  --we-role-accent-text: var(--we-color-primary-700);
  --we-role-accent-hover: var(--we-color-primary-600);
  --we-role-accent-active: var(--we-color-primary-700);
  --we-role-surface-hover: var(--we-color-neutral-100);
  --we-role-surface-active: var(--we-color-neutral-200);
  --we-role-control-surface: var(--we-color-neutral-200);
  --we-role-overlay: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) 4% / 60%);
  --we-role-shadow-color: hsl(var(--we-color-neutral-hue) var(--we-color-neutral-saturation) 4%);
  --we-role-focus: var(--we-color-primary-500);
  --we-role-danger-surface: var(--we-color-danger-50);
  --we-role-success-surface: var(--we-color-success-50);
  --we-role-warning-surface: var(--we-color-warning-50);
  --we-role-danger-text: var(--we-color-danger-600);
  --we-role-success-text: var(--we-color-success-800);
  --we-role-warning-text: var(--we-color-warning-700);

  /* Focus Colors */
  --we-color-focus: var(--we-color-primary-500);
  --we-focus-outline: 0 0 0 2px var(--we-color-focus);

  /* Gradient */
  --we-gradient-primary: linear-gradient(135deg, hsl(calc(var(--we-color-primary-hue) - 25) var(--we-color-saturation) var(--we-color-lightness-500)) 0%, hsl(calc(var(--we-color-primary-hue) + 25) var(--we-color-saturation) var(--we-color-lightness-500)) 100%);
}

@supports not (color: oklch(from red calc(l + 0.1) c h)) {
  :root {
    --we-role-surface: var(--we-color-neutral-0);
    --we-role-surface-raised: var(--we-color-neutral-0);
    --we-role-surface-sunken: var(--we-color-neutral-100);
  }
}

/*
  Forced-colors mode (Windows High Contrast, and its equivalents).

  Somebody in this mode has asked the operating system to replace every colour with a small,
  guaranteed-legible set, usually because the alternative is not readable for them. The right
  response is not to theme it — it is to stop competing with it and fix what flattening breaks.

  What breaks is anything distinguished by *background alone*: the browser replaces the fill, so a
  filled button, a selected row and a plain surface all end up the same colour with nothing between
  them. Giving those a border in a system colour restores the boundary the fill was carrying. The
  role variables are deliberately left alone — they still resolve, and \`forced-color-adjust\` is
  what actually decides what paints.
*/
@media (forced-colors: active) {
  :root {
    --we-role-focus: Highlight;
    --we-ring-color: Highlight;
    --we-role-border: CanvasText;
    --we-role-border-strong: CanvasText;
  }

  we-button::part(base),
  we-input::part(base),
  we-textarea::part(base),
  we-select::part(base),
  we-tag::part(base),
  we-badge::part(base),
  we-alert::part(base),
  we-modal::part(base),
  we-drawer::part(base),
  we-menu::part(base) {
    border: 1px solid CanvasText;
  }

  /* A focus ring drawn as a box-shadow disappears here — shadows are not painted. */
  :focus-visible {
    outline: 2px solid Highlight;
    outline-offset: 2px;
  }
}
"
`;

exports[`token CSS generation > component.css — scrollbar values come from the token source 1`] = `
