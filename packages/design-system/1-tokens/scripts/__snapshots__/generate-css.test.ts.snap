  --we-color-purple-800: oklch(var(--we-color-lightness-800) calc(var(--we-color-purple-saturation) / 100 * var(--we-color-purple-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-800), 1 - var(--we-color-lightness-800)))) var(--we-color-purple-hue));
  --we-color-purple-900: oklch(var(--we-color-lightness-900) calc(var(--we-color-purple-saturation) / 100 * var(--we-color-purple-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-900), 1 - var(--we-color-lightness-900)))) var(--we-color-purple-hue));
  --we-color-purple-1000: oklch(var(--we-color-lightness-1000) calc(var(--we-color-purple-saturation) / 100 * var(--we-color-purple-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-1000), 1 - var(--we-color-lightness-1000)))) var(--we-color-purple-hue));

  /* Pink Colors */
  --we-color-pink-0: oklch(var(--we-color-lightness-0) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-0), 1 - var(--we-color-lightness-0)))) var(--we-color-pink-hue));
  --we-color-pink-25: oklch(var(--we-color-lightness-25) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-25), 1 - var(--we-color-lightness-25)))) var(--we-color-pink-hue));
  --we-color-pink-50: oklch(var(--we-color-lightness-50) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-50), 1 - var(--we-color-lightness-50)))) var(--we-color-pink-hue));
  --we-color-pink-75: oklch(var(--we-color-lightness-75) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-75), 1 - var(--we-color-lightness-75)))) var(--we-color-pink-hue));
  --we-color-pink-100: oklch(var(--we-color-lightness-100) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-100), 1 - var(--we-color-lightness-100)))) var(--we-color-pink-hue));
  --we-color-pink-200: oklch(var(--we-color-lightness-200) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-200), 1 - var(--we-color-lightness-200)))) var(--we-color-pink-hue));
  --we-color-pink-300: oklch(var(--we-color-lightness-300) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-300), 1 - var(--we-color-lightness-300)))) var(--we-color-pink-hue));
  --we-color-pink-400: oklch(var(--we-color-lightness-400) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-400), 1 - var(--we-color-lightness-400)))) var(--we-color-pink-hue));
  --we-color-pink-500: oklch(var(--we-color-lightness-500) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-500), 1 - var(--we-color-lightness-500)))) var(--we-color-pink-hue));
  --we-color-pink-600: oklch(var(--we-color-lightness-600) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-600), 1 - var(--we-color-lightness-600)))) var(--we-color-pink-hue));
  --we-color-pink-700: oklch(var(--we-color-lightness-700) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-700), 1 - var(--we-color-lightness-700)))) var(--we-color-pink-hue));
  --we-color-pink-800: oklch(var(--we-color-lightness-800) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-800), 1 - var(--we-color-lightness-800)))) var(--we-color-pink-hue));
  --we-color-pink-900: oklch(var(--we-color-lightness-900) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-900), 1 - var(--we-color-lightness-900)))) var(--we-color-pink-hue));
  --we-color-pink-1000: oklch(var(--we-color-lightness-1000) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-1000), 1 - var(--we-color-lightness-1000)))) var(--we-color-pink-hue));

  /* Base Colors */
  --we-color-white: oklch(var(--we-color-lightness-0) 0 var(--we-color-neutral-hue));
  --we-color-black: oklch(var(--we-color-lightness-1000) 0 var(--we-color-neutral-hue));

  /* Semantic Roles — intent over scale position. Defaults are parametric expressions
     so every theme keeps working untouched; themes may pin individual roles
     (ThemeOverrides.roles in @we/themes → --we-role-*). */
  --we-role-page: oklch(from var(--we-role-chrome) calc(l + 0.03) c h);
  --we-role-chrome: oklch(from var(--we-color-neutral-50) calc(l + 0.01) c h);
  --we-role-surface: oklch(from var(--we-role-page) calc(l + 0.025) c h);
  --we-role-surface-raised: oklch(from var(--we-role-page) calc(l + 0.04) c h);
  --we-role-surface-sunken: oklch(from var(--we-role-page) calc(l - 0.035) c h);
  --we-role-text: var(--we-color-neutral-900);
  --we-role-text-muted: var(--we-color-neutral-600);
  --we-role-text-faint: var(--we-color-neutral-400);
  --we-role-on-inverse: oklch(98.5% calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 0.0300) var(--we-color-neutral-hue));
  --we-role-surface-inverse: oklch(from var(--we-role-page) clamp(0.04, calc(l - 0.09), 0.25) c h);
  --we-role-border: var(--we-color-neutral-200);
  --we-role-border-strong: var(--we-color-neutral-500);
  --we-role-border-hover: color-mix(in oklab, var(--we-role-border) 60%, var(--we-role-border-strong));
  --we-role-on-accent-muted: oklch(from var(--we-role-on-accent) l c h / 0.8);
  --we-role-surface-hover: color-mix(in oklab, var(--we-role-surface) 91%, var(--we-role-text));
  --we-role-surface-active: color-mix(in oklab, var(--we-role-surface) 82%, var(--we-role-text));
  --we-role-item-hover: var(--we-role-surface-hover);
  --we-role-selected: var(--we-role-accent-soft);
  --we-role-on-selected: var(--we-role-text);
  --we-role-text-selection: color-mix(in srgb, var(--we-role-accent) 30%, transparent);
  --we-role-surface-sunken-hover: color-mix(in oklab, var(--we-role-surface-sunken) 65%, var(--we-role-surface));
  --we-role-field: var(--we-role-surface-sunken);
  --we-role-field-hover: var(--we-role-surface-sunken-hover);
  --we-role-control-surface: var(--we-color-neutral-200);
  --we-role-overlay: oklch(14.6% calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 0.2920) var(--we-color-neutral-hue) / 60%);
  --we-role-shadow-color: oklch(14.6% calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 0.2920) var(--we-color-neutral-hue));
  --we-role-focus: var(--we-role-accent);
  --we-role-accent: oklch(calc(var(--we-accent-lightness, 55) * 1%) calc(var(--we-color-accent-saturation) / 100 * var(--we-color-accent-fill-chroma-max, 0.2663)) var(--we-color-accent-hue));
  --we-role-on-accent: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-accent-soft: var(--we-color-accent-100);
  --we-role-accent-text: var(--we-color-accent-700);
  --we-role-accent-border: var(--we-color-accent-300);
  --we-role-accent-hover: oklch(from var(--we-role-accent) calc(l + var(--we-state-hover-accent, var(--we-state-hover))) c h);
  --we-role-accent-active: oklch(from var(--we-role-accent) calc(l + var(--we-state-active-accent, var(--we-state-active))) c h);
  --we-role-success: oklch(calc(var(--we-success-lightness, 75) * 1%) calc(var(--we-color-success-saturation) / 100 * var(--we-color-success-fill-chroma-max, 0.2365)) var(--we-color-success-hue));
  --we-role-on-success: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-success-soft: var(--we-color-success-50);
  --we-role-success-text: var(--we-color-success-700);
  --we-role-success-border: var(--we-color-success-300);
  --we-role-success-hover: oklch(from var(--we-role-success) calc(l + var(--we-state-hover-success, var(--we-state-hover))) c h);
  --we-role-success-active: oklch(from var(--we-role-success) calc(l + var(--we-state-active-success, var(--we-state-active))) c h);
  --we-role-warning: oklch(calc(var(--we-warning-lightness, 76) * 1%) calc(var(--we-color-warning-saturation) / 100 * var(--we-color-warning-fill-chroma-max, 0.1558)) var(--we-color-warning-hue));
  --we-role-on-warning: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-warning-soft: var(--we-color-warning-50);
  --we-role-warning-text: var(--we-color-warning-700);
  --we-role-warning-border: var(--we-color-warning-300);
  --we-role-warning-hover: oklch(from var(--we-role-warning) calc(l + var(--we-state-hover-warning, var(--we-state-hover))) c h);
  --we-role-warning-active: oklch(from var(--we-role-warning) calc(l + var(--we-state-active-warning, var(--we-state-active))) c h);
  --we-role-danger: oklch(calc(var(--we-danger-lightness, 62) * 1%) calc(var(--we-color-danger-saturation) / 100 * var(--we-color-danger-fill-chroma-max, 0.2491)) var(--we-color-danger-hue));
  --we-role-on-danger: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-danger-soft: var(--we-color-danger-50);
  --we-role-danger-text: var(--we-color-danger-700);
  --we-role-danger-border: var(--we-color-danger-300);
  --we-role-danger-hover: oklch(from var(--we-role-danger) calc(l + var(--we-state-hover-danger, var(--we-state-hover))) c h);
  --we-role-danger-active: oklch(from var(--we-role-danger) calc(l + var(--we-state-active-danger, var(--we-state-active))) c h);
  --we-role-red: oklch(calc(var(--we-red-lightness, calc(60 + var(--we-color-palette-lightness, 0))) * 1%) calc(var(--we-color-red-saturation) / 100 * var(--we-color-red-fill-chroma-max, 0.2)) var(--we-color-red-hue));
  --we-role-on-red: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-red-soft: var(--we-color-red-100);
  --we-role-red-text: var(--we-color-red-700);
  --we-role-red-border: var(--we-color-red-300);
  --we-role-red-hover: oklch(from var(--we-role-red) calc(l + var(--we-state-hover-red, var(--we-state-hover))) c h);
  --we-role-red-active: oklch(from var(--we-role-red) calc(l + var(--we-state-active-red, var(--we-state-active))) c h);
  --we-role-orange: oklch(calc(var(--we-orange-lightness, calc(70 + var(--we-color-palette-lightness, 0))) * 1%) calc(var(--we-color-orange-saturation) / 100 * var(--we-color-orange-fill-chroma-max, 0.2)) var(--we-color-orange-hue));
  --we-role-on-orange: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-orange-soft: var(--we-color-orange-100);
  --we-role-orange-text: var(--we-color-orange-700);
  --we-role-orange-border: var(--we-color-orange-300);
  --we-role-orange-hover: oklch(from var(--we-role-orange) calc(l + var(--we-state-hover-orange, var(--we-state-hover))) c h);
  --we-role-orange-active: oklch(from var(--we-role-orange) calc(l + var(--we-state-active-orange, var(--we-state-active))) c h);
  --we-role-yellow: oklch(calc(var(--we-yellow-lightness, calc(84 + var(--we-color-palette-lightness, 0))) * 1%) calc(var(--we-color-yellow-saturation) / 100 * var(--we-color-yellow-fill-chroma-max, 0.2)) var(--we-color-yellow-hue));
  --we-role-on-yellow: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-yellow-soft: var(--we-color-yellow-100);
  --we-role-yellow-text: var(--we-color-yellow-700);
  --we-role-yellow-border: var(--we-color-yellow-300);
  --we-role-yellow-hover: oklch(from var(--we-role-yellow) calc(l + var(--we-state-hover-yellow, var(--we-state-hover))) c h);
  --we-role-yellow-active: oklch(from var(--we-role-yellow) calc(l + var(--we-state-active-yellow, var(--we-state-active))) c h);
  --we-role-lime: oklch(calc(var(--we-lime-lightness, calc(80 + var(--we-color-palette-lightness, 0))) * 1%) calc(var(--we-color-lime-saturation) / 100 * var(--we-color-lime-fill-chroma-max, 0.2)) var(--we-color-lime-hue));
  --we-role-on-lime: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-lime-soft: var(--we-color-lime-100);
  --we-role-lime-text: var(--we-color-lime-700);
  --we-role-lime-border: var(--we-color-lime-300);
  --we-role-lime-hover: oklch(from var(--we-role-lime) calc(l + var(--we-state-hover-lime, var(--we-state-hover))) c h);
  --we-role-lime-active: oklch(from var(--we-role-lime) calc(l + var(--we-state-active-lime, var(--we-state-active))) c h);
  --we-role-green: oklch(calc(var(--we-green-lightness, calc(68 + var(--we-color-palette-lightness, 0))) * 1%) calc(var(--we-color-green-saturation) / 100 * var(--we-color-green-fill-chroma-max, 0.2)) var(--we-color-green-hue));
  --we-role-on-green: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-green-soft: var(--we-color-green-100);
  --we-role-green-text: var(--we-color-green-700);
  --we-role-green-border: var(--we-color-green-300);
  --we-role-green-hover: oklch(from var(--we-role-green) calc(l + var(--we-state-hover-green, var(--we-state-hover))) c h);
  --we-role-green-active: oklch(from var(--we-role-green) calc(l + var(--we-state-active-green, var(--we-state-active))) c h);
  --we-role-teal: oklch(calc(var(--we-teal-lightness, calc(66 + var(--we-color-palette-lightness, 0))) * 1%) calc(var(--we-color-teal-saturation) / 100 * var(--we-color-teal-fill-chroma-max, 0.2)) var(--we-color-teal-hue));
  --we-role-on-teal: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-teal-soft: var(--we-color-teal-100);
  --we-role-teal-text: var(--we-color-teal-700);
  --we-role-teal-border: var(--we-color-teal-300);
  --we-role-teal-hover: oklch(from var(--we-role-teal) calc(l + var(--we-state-hover-teal, var(--we-state-hover))) c h);
  --we-role-teal-active: oklch(from var(--we-role-teal) calc(l + var(--we-state-active-teal, var(--we-state-active))) c h);
  --we-role-cyan: oklch(calc(var(--we-cyan-lightness, calc(70 + var(--we-color-palette-lightness, 0))) * 1%) calc(var(--we-color-cyan-saturation) / 100 * var(--we-color-cyan-fill-chroma-max, 0.2)) var(--we-color-cyan-hue));
  --we-role-on-cyan: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-cyan-soft: var(--we-color-cyan-100);
  --we-role-cyan-text: var(--we-color-cyan-700);
  --we-role-cyan-border: var(--we-color-cyan-300);
  --we-role-cyan-hover: oklch(from var(--we-role-cyan) calc(l + var(--we-state-hover-cyan, var(--we-state-hover))) c h);
  --we-role-cyan-active: oklch(from var(--we-role-cyan) calc(l + var(--we-state-active-cyan, var(--we-state-active))) c h);
  --we-role-blue: oklch(calc(var(--we-blue-lightness, calc(58 + var(--we-color-palette-lightness, 0))) * 1%) calc(var(--we-color-blue-saturation) / 100 * var(--we-color-blue-fill-chroma-max, 0.2)) var(--we-color-blue-hue));
  --we-role-on-blue: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-blue-soft: var(--we-color-blue-100);
  --we-role-blue-text: var(--we-color-blue-700);
  --we-role-blue-border: var(--we-color-blue-300);
  --we-role-blue-hover: oklch(from var(--we-role-blue) calc(l + var(--we-state-hover-blue, var(--we-state-hover))) c h);
  --we-role-blue-active: oklch(from var(--we-role-blue) calc(l + var(--we-state-active-blue, var(--we-state-active))) c h);
  --we-role-purple: oklch(calc(var(--we-purple-lightness, calc(58 + var(--we-color-palette-lightness, 0))) * 1%) calc(var(--we-color-purple-saturation) / 100 * var(--we-color-purple-fill-chroma-max, 0.2)) var(--we-color-purple-hue));
  --we-role-on-purple: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-purple-soft: var(--we-color-purple-100);
  --we-role-purple-text: var(--we-color-purple-700);
  --we-role-purple-border: var(--we-color-purple-300);
  --we-role-purple-hover: oklch(from var(--we-role-purple) calc(l + var(--we-state-hover-purple, var(--we-state-hover))) c h);
  --we-role-purple-active: oklch(from var(--we-role-purple) calc(l + var(--we-state-active-purple, var(--we-state-active))) c h);
  --we-role-pink: oklch(calc(var(--we-pink-lightness, calc(66 + var(--we-color-palette-lightness, 0))) * 1%) calc(var(--we-color-pink-saturation) / 100 * var(--we-color-pink-fill-chroma-max, 0.2)) var(--we-color-pink-hue));
  --we-role-on-pink: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-pink-soft: var(--we-color-pink-100);
  --we-role-pink-text: var(--we-color-pink-700);
  --we-role-pink-border: var(--we-color-pink-300);
  --we-role-pink-hover: oklch(from var(--we-role-pink) calc(l + var(--we-state-hover-pink, var(--we-state-hover))) c h);
  --we-role-pink-active: oklch(from var(--we-role-pink) calc(l + var(--we-state-active-pink, var(--we-state-active))) c h);
  --we-role-neutral: var(--we-role-surface-inverse);
  --we-role-on-neutral: var(--we-role-on-inverse);
  --we-role-neutral-soft: var(--we-role-control-surface);
  --we-role-neutral-text: var(--we-role-text-muted);
  --we-role-neutral-border: var(--we-role-border-strong);
  --we-role-neutral-hover: oklch(from var(--we-role-neutral) calc(l + var(--we-state-hover-neutral, var(--we-state-hover))) c h);
  --we-role-neutral-active: oklch(from var(--we-role-neutral) calc(l + var(--we-state-active-neutral, var(--we-state-active))) c h);

  /* Focus Colors */
  --we-color-focus: var(--we-role-focus);
  /* Themeable width, like --we-border-width: a focus ring is a stroke, and a theme that
     thickens its borders and cannot thicken its rings looks half-converted. */
  --we-focus-ring-width: var(--we-theme-focus-ring-width, 2px);
  --we-focus-outline: 0 0 0 var(--we-focus-ring-width) var(--we-color-focus);

  /* Gradient */
  --we-gradient-accent: linear-gradient(135deg, oklch(var(--we-color-lightness-500) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.8) calc(var(--we-color-accent-hue) - 25)) 0%, oklch(var(--we-color-lightness-500) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.8) calc(var(--we-color-accent-hue) + 25)) 100%);
}

@supports not (color: oklch(from red calc(l + 0.1) c h)) {
  :root {
    --we-role-surface: var(--we-color-neutral-0);
    --we-role-surface-raised: var(--we-color-neutral-0);
    --we-role-surface-sunken: var(--we-color-neutral-100);
    --we-role-surface-inverse: oklch(24.8% calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 0.4960) var(--we-color-neutral-hue));
    --we-role-on-accent-muted: var(--we-role-on-accent);
    --we-role-accent-hover: var(--we-role-accent);
    --we-role-accent-active: var(--we-role-accent);
    --we-role-success-hover: var(--we-role-success);
    --we-role-success-active: var(--we-role-success);
    --we-role-warning-hover: var(--we-role-warning);
    --we-role-warning-active: var(--we-role-warning);
    --we-role-danger-hover: var(--we-role-danger);
    --we-role-danger-active: var(--we-role-danger);
    --we-role-red-hover: var(--we-role-red);
    --we-role-red-active: var(--we-role-red);
    --we-role-orange-hover: var(--we-role-orange);
    --we-role-orange-active: var(--we-role-orange);
    --we-role-yellow-hover: var(--we-role-yellow);
    --we-role-yellow-active: var(--we-role-yellow);
    --we-role-lime-hover: var(--we-role-lime);
    --we-role-lime-active: var(--we-role-lime);
    --we-role-green-hover: var(--we-role-green);
    --we-role-green-active: var(--we-role-green);
    --we-role-teal-hover: var(--we-role-teal);
    --we-role-teal-active: var(--we-role-teal);
    --we-role-cyan-hover: var(--we-role-cyan);
    --we-role-cyan-active: var(--we-role-cyan);
    --we-role-blue-hover: var(--we-role-blue);
    --we-role-blue-active: var(--we-role-blue);
    --we-role-purple-hover: var(--we-role-purple);
    --we-role-purple-active: var(--we-role-purple);
    --we-role-pink-hover: var(--we-role-pink);
    --we-role-pink-active: var(--we-role-pink);
    --we-role-neutral-hover: var(--we-role-neutral);
    --we-role-neutral-active: var(--we-role-neutral);
  }
}

/*
  Forced-colors mode (Windows High Contrast, and its equivalents).

  Somebody in this mode has asked the operating system to replace every colour with a small,
  guaranteed-legible set, usually because the alternative is not readable for them. The right
  response is not to theme it — it is to stop competing with it and fix what flattening breaks.

  What breaks is anything distinguished by *background alone*: the browser replaces the fill, so a
  filled button, a selected row and a plain surface all end up the same colour with nothing between
  them. Giving those a border in a system colour restores the boundary the fill was carrying. The
  role variables are deliberately left alone — they still resolve, and \`forced-color-adjust\` is
  what actually decides what paints.
*/
@media (forced-colors: active) {
  :root {
    --we-role-focus: Highlight;
    --we-ring-color: Highlight;
    --we-role-border: CanvasText;
    --we-role-border-strong: CanvasText;
  }

  we-button::part(base),
  we-input::part(base),
  we-textarea::part(base),
  we-select::part(base),
  we-tag::part(base),
  we-badge::part(base),
  we-alert::part(base),
  we-modal::part(base),
  we-drawer::part(base),
  we-menu::part(base) {
    border: 1px solid CanvasText;
  }

  /* A focus ring drawn as a box-shadow disappears here — shadows are not painted. */
  :focus-visible {
    outline: 2px solid Highlight;
    outline-offset: 2px;
  }
}
"
`;

exports[`token CSS generation > component.css — scrollbar values come from the token source 1`] = `
"/* COMPONENT TOKENS - Generated from JS tokens */

:root {
  /* Scrollbar Styles */
  --we-scrollbar-width: 10px;
  --we-scrollbar-background-image: none;
  --we-scrollbar-background: transparent;
  --we-scrollbar-corner-background: transparent;
  --we-scrollbar-thumb-box-shadow: none;
  --we-scrollbar-thumb-border-radius: var(--we-radius-pill);
  --we-scrollbar-thumb-inset: 2px;
  --we-scrollbar-thumb-background: var(--we-role-control-surface);
}"
`;

exports[`token CSS generation > font.css — families, sizes, weights, line heights, letter spacing 1`] = `
"/* FONT TOKENS - Generated from JS tokens */

:root {
  /* Font Family Palette */
  --we-font-family-base: 'DM Sans', sans-serif;
  --we-font-family-mozilla: 'Mozilla Text', serif;
  --we-font-family-boldonse: 'Boldonse', serif;
  --we-font-family-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;

  /* Active font family — used by all components; themes can override this */
  --we-font-family: var(--we-font-family-base);

  /* Active code face. Read by we-code, we-markdown and we-html, all of which asked for it long
     before anything declared it. */
  --we-font-mono: var(--we-font-family-mono);

  /* Font Sizes */
  --we-font-base-size: 16px;
  --we-font-size-100: calc(0.75rem * var(--we-theme-scoped-font-scale, 1));
  --we-font-size-200: calc(0.875rem * var(--we-theme-scoped-font-scale, 1));
  --we-font-size-300: calc(1rem * var(--we-theme-scoped-font-scale, 1));
  --we-font-size-400: calc(1.125rem * var(--we-theme-scoped-font-scale, 1));
  --we-font-size-500: calc(1.25rem * var(--we-theme-scoped-font-scale, 1));
  --we-font-size-600: calc(1.5rem * var(--we-theme-scoped-font-scale, 1));
  --we-font-size-700: calc(2rem * var(--we-theme-scoped-font-scale, 1));
  --we-font-size-800: calc(2.5rem * var(--we-theme-scoped-font-scale, 1));
  --we-font-size-900: calc(3.5rem * var(--we-theme-scoped-font-scale, 1));
  --we-font-size-1000: calc(4.5rem * var(--we-theme-scoped-font-scale, 1));

  /* Font Weights */
  --we-font-weight-100: 100;
  --we-font-weight-200: 200;
  --we-font-weight-300: 300;
  --we-font-weight-400: 400;
  --we-font-weight-500: 500;
  --we-font-weight-600: 600;
  --we-font-weight-700: 700;
  --we-font-weight-800: 800;
  --we-font-weight-900: 900;
  --we-font-weight-regular: 400;
  --we-font-weight-medium: 500;
  --we-font-weight-semibold: 600;
  --we-font-weight-bold: 700;

  /* Line Heights */
  --we-line-height-none: 1;
  --we-line-height-tight: 1.25;
  --we-line-height-snug: 1.375;
  --we-line-height-normal: 1.5;
  --we-line-height-relaxed: 1.625;
  --we-line-height-loose: 2;

  /* Letter Spacing */
  --we-letter-spacing-tighter: -0.05em;
  --we-letter-spacing-tight: -0.025em;
  --we-letter-spacing-normal: 0;
  --we-letter-spacing-wide: 0.025em;
  --we-letter-spacing-wider: 0.05em;
  --we-letter-spacing-widest: 0.1em;
}"
`;

exports[`token CSS generation > size.css — sizes, radii, avatar sizes, component heights 1`] = `
"/* SIZE TOKENS - Generated from JS tokens */

:root {
  /* Component Sizes */
  --we-size-xxs: 0.75rem;
  --we-size-xs: 1rem;
  --we-size-sm: 1.5rem;
  --we-size-md: 2rem;
  --we-size-lg: 2.5rem;
  --we-size-xl: 3rem;
  --we-size-xxl: 4rem;

  /* Border Radius Sizes */
  --we-radius-0: 0;
  --we-radius-100: 0.125rem;
  --we-radius-200: 0.25rem;
  --we-radius-300: 0.375rem;
  --we-radius-400: 0.5rem;
  --we-radius-500: 0.75rem;
  --we-radius-600: 1rem;
  --we-radius-700: 1.25rem;
  --we-radius-800: 1.5rem;
  --we-radius-900: 2rem;
  --we-radius-pill: 9999px;
  --we-radius-full: 50%;

  /* Avatar Sizes */
  --we-avatar-size-xxs: 1rem;
  --we-avatar-size-xs: 1.5rem;
  --we-avatar-size-sm: 2rem;
  --we-avatar-size-md: 2.5rem;
  --we-avatar-size-lg: 3rem;
  --we-avatar-size-xl: 4rem;
  --we-avatar-size-xxl: 5rem;

  /* Component Heights */
  --we-component-height-xs: 1.5rem;
  --we-component-height-sm: 2rem;
  --we-component-height-md: 2.5rem;
  --we-component-height-lg: 3rem;
  --we-component-height-xl: 3.5rem;
}"
`;

exports[`token CSS generation > space.css 1`] = `
