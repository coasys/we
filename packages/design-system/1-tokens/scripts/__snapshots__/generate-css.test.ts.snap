// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`token CSS generation > color.css — hues, lightness ramp, palettes, roles, gradient 1`] = `
"/* COLOR TOKENS - Generated from JS tokens */

:root {
  /* Color System Configuration */
  --we-color-lightness-floor: 0%;
  --we-color-lightness-ceiling: 100%;
  --we-color-ramp-offset: 0;
  --we-color-ramp-direction: 1;
  --we-color-saturation: 60;
  --we-color-neutral-saturation: 10;

  /* Color Hues */
  --we-color-neutral-hue: var(--we-color-primary-hue);
  --we-color-primary-hue: 281;
  --we-color-success-hue: 145;
  --we-color-warning-hue: 90;
  --we-color-danger-hue: 17;

  /* Lightness Scale */
  --we-color-lightness-0: calc(var(--we-color-lightness-floor) + (1 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-25: calc(var(--we-color-lightness-floor) + (0.98 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-50: calc(var(--we-color-lightness-floor) + (0.96 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-75: calc(var(--we-color-lightness-floor) + (0.945 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-100: calc(var(--we-color-lightness-floor) + (0.925 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-200: calc(var(--we-color-lightness-floor) + (0.845 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-300: calc(var(--we-color-lightness-floor) + (0.765 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-400: calc(var(--we-color-lightness-floor) + (0.685 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-500: calc(var(--we-color-lightness-floor) + (0.6 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-600: calc(var(--we-color-lightness-floor) + (0.51 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-700: calc(var(--we-color-lightness-floor) + (0.42 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-800: calc(var(--we-color-lightness-floor) + (0.32 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-900: calc(var(--we-color-lightness-floor) + (0.215 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-1000: calc(var(--we-color-lightness-floor) + (0 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));

  /* Neutral Colors */
  --we-color-neutral-0: oklch(var(--we-color-lightness-0) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0) var(--we-color-neutral-hue));
  --we-color-neutral-25: oklch(var(--we-color-lightness-25) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.04) var(--we-color-neutral-hue));
  --we-color-neutral-50: oklch(var(--we-color-lightness-50) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.08) var(--we-color-neutral-hue));
  --we-color-neutral-75: oklch(var(--we-color-lightness-75) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.11) var(--we-color-neutral-hue));
  --we-color-neutral-100: oklch(var(--we-color-lightness-100) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.15) var(--we-color-neutral-hue));
  --we-color-neutral-200: oklch(var(--we-color-lightness-200) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.31) var(--we-color-neutral-hue));
  --we-color-neutral-300: oklch(var(--we-color-lightness-300) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.47) var(--we-color-neutral-hue));
  --we-color-neutral-400: oklch(var(--we-color-lightness-400) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.63) var(--we-color-neutral-hue));
  --we-color-neutral-500: oklch(var(--we-color-lightness-500) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.8) var(--we-color-neutral-hue));
  --we-color-neutral-600: oklch(var(--we-color-lightness-600) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.98) var(--we-color-neutral-hue));
  --we-color-neutral-700: oklch(var(--we-color-lightness-700) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.84) var(--we-color-neutral-hue));
  --we-color-neutral-800: oklch(var(--we-color-lightness-800) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.64) var(--we-color-neutral-hue));
  --we-color-neutral-900: oklch(var(--we-color-lightness-900) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.43) var(--we-color-neutral-hue));
  --we-color-neutral-1000: oklch(var(--we-color-lightness-1000) calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0) var(--we-color-neutral-hue));

  /* Primary Colors */
  --we-color-primary-0: oklch(var(--we-color-lightness-0) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0) var(--we-color-primary-hue));
  --we-color-primary-25: oklch(var(--we-color-lightness-25) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.04) var(--we-color-primary-hue));
  --we-color-primary-50: oklch(var(--we-color-lightness-50) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.08) var(--we-color-primary-hue));
  --we-color-primary-75: oklch(var(--we-color-lightness-75) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.11) var(--we-color-primary-hue));
  --we-color-primary-100: oklch(var(--we-color-lightness-100) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.15) var(--we-color-primary-hue));
  --we-color-primary-200: oklch(var(--we-color-lightness-200) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.31) var(--we-color-primary-hue));
  --we-color-primary-300: oklch(var(--we-color-lightness-300) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.47) var(--we-color-primary-hue));
  --we-color-primary-400: oklch(var(--we-color-lightness-400) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.63) var(--we-color-primary-hue));
  --we-color-primary-500: oklch(var(--we-color-lightness-500) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.8) var(--we-color-primary-hue));
  --we-color-primary-600: oklch(var(--we-color-lightness-600) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.98) var(--we-color-primary-hue));
  --we-color-primary-700: oklch(var(--we-color-lightness-700) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.84) var(--we-color-primary-hue));
  --we-color-primary-800: oklch(var(--we-color-lightness-800) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.64) var(--we-color-primary-hue));
  --we-color-primary-900: oklch(var(--we-color-lightness-900) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.43) var(--we-color-primary-hue));
  --we-color-primary-1000: oklch(var(--we-color-lightness-1000) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0) var(--we-color-primary-hue));

  /* Success Colors */
  --we-color-success-0: oklch(var(--we-color-lightness-0) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0) var(--we-color-success-hue));
  --we-color-success-25: oklch(var(--we-color-lightness-25) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.04) var(--we-color-success-hue));
  --we-color-success-50: oklch(var(--we-color-lightness-50) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.08) var(--we-color-success-hue));
  --we-color-success-75: oklch(var(--we-color-lightness-75) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.11) var(--we-color-success-hue));
  --we-color-success-100: oklch(var(--we-color-lightness-100) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.15) var(--we-color-success-hue));
  --we-color-success-200: oklch(var(--we-color-lightness-200) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.31) var(--we-color-success-hue));
  --we-color-success-300: oklch(var(--we-color-lightness-300) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.47) var(--we-color-success-hue));
  --we-color-success-400: oklch(var(--we-color-lightness-400) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.63) var(--we-color-success-hue));
  --we-color-success-500: oklch(var(--we-color-lightness-500) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.8) var(--we-color-success-hue));
  --we-color-success-600: oklch(var(--we-color-lightness-600) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.98) var(--we-color-success-hue));
  --we-color-success-700: oklch(var(--we-color-lightness-700) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.84) var(--we-color-success-hue));
  --we-color-success-800: oklch(var(--we-color-lightness-800) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.64) var(--we-color-success-hue));
  --we-color-success-900: oklch(var(--we-color-lightness-900) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.43) var(--we-color-success-hue));
  --we-color-success-1000: oklch(var(--we-color-lightness-1000) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0) var(--we-color-success-hue));

  /* Warning Colors */
  --we-color-warning-0: oklch(var(--we-color-lightness-0) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0) var(--we-color-warning-hue));
  --we-color-warning-25: oklch(var(--we-color-lightness-25) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.04) var(--we-color-warning-hue));
  --we-color-warning-50: oklch(var(--we-color-lightness-50) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.08) var(--we-color-warning-hue));
  --we-color-warning-75: oklch(var(--we-color-lightness-75) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.11) var(--we-color-warning-hue));
  --we-color-warning-100: oklch(var(--we-color-lightness-100) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.15) var(--we-color-warning-hue));
  --we-color-warning-200: oklch(var(--we-color-lightness-200) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.31) var(--we-color-warning-hue));
  --we-color-warning-300: oklch(var(--we-color-lightness-300) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.47) var(--we-color-warning-hue));
  --we-color-warning-400: oklch(var(--we-color-lightness-400) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.63) var(--we-color-warning-hue));
  --we-color-warning-500: oklch(var(--we-color-lightness-500) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.8) var(--we-color-warning-hue));
  --we-color-warning-600: oklch(var(--we-color-lightness-600) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.98) var(--we-color-warning-hue));
  --we-color-warning-700: oklch(var(--we-color-lightness-700) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.84) var(--we-color-warning-hue));
  --we-color-warning-800: oklch(var(--we-color-lightness-800) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.64) var(--we-color-warning-hue));
  --we-color-warning-900: oklch(var(--we-color-lightness-900) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.43) var(--we-color-warning-hue));
  --we-color-warning-1000: oklch(var(--we-color-lightness-1000) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0) var(--we-color-warning-hue));

  /* Danger Colors */
  --we-color-danger-0: oklch(var(--we-color-lightness-0) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0) var(--we-color-danger-hue));
  --we-color-danger-25: oklch(var(--we-color-lightness-25) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.04) var(--we-color-danger-hue));
  --we-color-danger-50: oklch(var(--we-color-lightness-50) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.08) var(--we-color-danger-hue));
  --we-color-danger-75: oklch(var(--we-color-lightness-75) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.11) var(--we-color-danger-hue));
  --we-color-danger-100: oklch(var(--we-color-lightness-100) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.15) var(--we-color-danger-hue));
  --we-color-danger-200: oklch(var(--we-color-lightness-200) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.31) var(--we-color-danger-hue));
  --we-color-danger-300: oklch(var(--we-color-lightness-300) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.47) var(--we-color-danger-hue));
  --we-color-danger-400: oklch(var(--we-color-lightness-400) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.63) var(--we-color-danger-hue));
  --we-color-danger-500: oklch(var(--we-color-lightness-500) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.8) var(--we-color-danger-hue));
  --we-color-danger-600: oklch(var(--we-color-lightness-600) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.98) var(--we-color-danger-hue));
  --we-color-danger-700: oklch(var(--we-color-lightness-700) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.84) var(--we-color-danger-hue));
  --we-color-danger-800: oklch(var(--we-color-lightness-800) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.64) var(--we-color-danger-hue));
  --we-color-danger-900: oklch(var(--we-color-lightness-900) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.43) var(--we-color-danger-hue));
  --we-color-danger-1000: oklch(var(--we-color-lightness-1000) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0) var(--we-color-danger-hue));

  /* Base Colors */
  --we-color-white: oklch(var(--we-color-lightness-0) 0 var(--we-color-neutral-hue));
  --we-color-black: oklch(var(--we-color-lightness-1000) 0 var(--we-color-neutral-hue));

  /* Semantic Roles — intent over scale position. Defaults are parametric expressions
     so every theme keeps working untouched; themes may pin individual roles
     (ThemeOverrides.roles in @we/themes → --we-role-*). */
  --we-role-page: var(--we-color-neutral-50);
  --we-role-surface: oklch(from var(--we-role-page) calc(l + 0.045) c h);
  --we-role-surface-raised: oklch(from var(--we-role-page) calc(l + 0.1) c h);
  --we-role-surface-sunken: oklch(from var(--we-role-page) calc(l - 0.035) c h);
  --we-role-text: var(--we-color-neutral-900);
  --we-role-text-muted: var(--we-color-neutral-600);
  --we-role-text-faint: var(--we-color-neutral-400);
  --we-role-on-inverse: oklch(98% calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.0400) var(--we-color-neutral-hue));
  --we-role-surface-inverse: oklch(13% calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.2600) var(--we-color-neutral-hue));
  --we-role-border: var(--we-color-neutral-200);
  --we-role-border-strong: var(--we-color-neutral-500);
  --we-role-accent: var(--we-color-primary-700);
  --we-role-on-accent: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-accent-muted: var(--we-color-primary-100);
  --we-role-accent-text: var(--we-color-primary-700);
  --we-role-accent-hover: var(--we-color-primary-800);
  --we-role-accent-active: var(--we-color-primary-900);
  --we-role-surface-hover: var(--we-color-neutral-100);
  --we-role-surface-active: var(--we-color-neutral-200);
  --we-role-control-surface: var(--we-color-neutral-200);
  --we-role-overlay: oklch(4% calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.0800) var(--we-color-neutral-hue) / 60%);
  --we-role-shadow-color: oklch(4% calc(min(var(--we-color-neutral-saturation) * 0.0035, 0.18) * 0.0800) var(--we-color-neutral-hue));
  --we-role-focus: var(--we-color-primary-500);
  --we-role-danger: var(--we-color-danger-600);
  --we-role-success: var(--we-color-success-600);
  --we-role-warning: var(--we-color-warning-600);
  --we-role-on-status: oklch(100% 0 var(--we-color-neutral-hue));
  --we-role-danger-surface: var(--we-color-danger-50);
  --we-role-success-surface: var(--we-color-success-50);
  --we-role-warning-surface: var(--we-color-warning-50);
  --we-role-danger-text: var(--we-color-danger-700);
  --we-role-success-text: var(--we-color-success-700);
  --we-role-warning-text: var(--we-color-warning-700);

  /* Focus Colors */
  --we-color-focus: var(--we-color-primary-500);
  --we-focus-outline: 0 0 0 2px var(--we-color-focus);

  /* Gradient */
  --we-gradient-primary: linear-gradient(135deg, oklch(var(--we-color-lightness-500) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.8) calc(var(--we-color-primary-hue) - 25)) 0%, oklch(var(--we-color-lightness-500) calc(min(var(--we-color-saturation) * 0.0035, 0.18) * 0.8) calc(var(--we-color-primary-hue) + 25)) 100%);
}

@supports not (color: oklch(from red calc(l + 0.1) c h)) {
  :root {
    --we-role-surface: var(--we-color-neutral-0);
    --we-role-surface-raised: var(--we-color-neutral-0);
    --we-role-surface-sunken: var(--we-color-neutral-100);
  }
}

/*
  Forced-colors mode (Windows High Contrast, and its equivalents).

  Somebody in this mode has asked the operating system to replace every colour with a small,
  guaranteed-legible set, usually because the alternative is not readable for them. The right
  response is not to theme it — it is to stop competing with it and fix what flattening breaks.

  What breaks is anything distinguished by *background alone*: the browser replaces the fill, so a
  filled button, a selected row and a plain surface all end up the same colour with nothing between
  them. Giving those a border in a system colour restores the boundary the fill was carrying. The
  role variables are deliberately left alone — they still resolve, and \`forced-color-adjust\` is
  what actually decides what paints.
*/
@media (forced-colors: active) {
  :root {
    --we-role-focus: Highlight;
    --we-ring-color: Highlight;
    --we-role-border: CanvasText;
    --we-role-border-strong: CanvasText;
  }

  we-button::part(base),
  we-input::part(base),
  we-textarea::part(base),
  we-select::part(base),
  we-tag::part(base),
  we-badge::part(base),
  we-alert::part(base),
  we-modal::part(base),
  we-drawer::part(base),
  we-menu::part(base) {
    border: 1px solid CanvasText;
  }

  /* A focus ring drawn as a box-shadow disappears here — shadows are not painted. */
  :focus-visible {
    outline: 2px solid Highlight;
    outline-offset: 2px;
  }
}
"
`;

exports[`token CSS generation > component.css — scrollbar values come from the token source 1`] = `
"/* COMPONENT TOKENS - Generated from JS tokens */

:root {
  /* Scrollbar Styles */
  --we-scrollbar-width: 6px;
  --we-scrollbar-background-image: none;
  --we-scrollbar-background: transparent;
  --we-scrollbar-corner-background: transparent;
  --we-scrollbar-thumb-box-shadow: none;
  --we-scrollbar-thumb-border-radius: var(--we-radius-pill);
  --we-scrollbar-thumb-background: var(--we-color-neutral-100);
}"
`;

exports[`token CSS generation > font.css — families, sizes, weights, line heights, letter spacing 1`] = `
"/* FONT TOKENS - Generated from JS tokens */

:root {
  /* Font Family Palette */
  --we-font-family-base: 'DM Sans', sans-serif;
  --we-font-family-mozilla: 'Mozilla Text', serif;
  --we-font-family-boldonse: 'Boldonse', serif;
  --we-font-family-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;

  /* Active font family — used by all components; themes can override this */
  --we-font-family: var(--we-font-family-base);

  /* Active code face. Read by we-code, we-markdown and we-html, all of which asked for it long
     before anything declared it. */
  --we-font-mono: var(--we-font-family-mono);

  /* Font Sizes */
  --we-font-base-size: 16px;
  --we-font-size-100: 0.75rem;
  --we-font-size-200: 0.875rem;
  --we-font-size-300: 1rem;
  --we-font-size-400: 1.125rem;
  --we-font-size-500: 1.25rem;
  --we-font-size-600: 1.5rem;
  --we-font-size-700: 2rem;
  --we-font-size-800: 2.5rem;
  --we-font-size-900: 3.5rem;
  --we-font-size-1000: 4.5rem;

  /* Font Weights */
  --we-font-weight-100: 100;
  --we-font-weight-200: 200;
  --we-font-weight-300: 300;
  --we-font-weight-400: 400;
  --we-font-weight-500: 500;
  --we-font-weight-600: 600;
  --we-font-weight-700: 700;
  --we-font-weight-800: 800;
  --we-font-weight-900: 900;
  --we-font-weight-regular: 400;
  --we-font-weight-medium: 500;
  --we-font-weight-semibold: 600;
  --we-font-weight-bold: 700;

  /* Line Heights */
  --we-line-height-none: 1;
  --we-line-height-tight: 1.25;
  --we-line-height-snug: 1.375;
  --we-line-height-normal: 1.5;
  --we-line-height-relaxed: 1.625;
  --we-line-height-loose: 2;

  /* Letter Spacing */
  --we-letter-spacing-tighter: -0.05em;
  --we-letter-spacing-tight: -0.025em;
  --we-letter-spacing-normal: 0;
  --we-letter-spacing-wide: 0.025em;
  --we-letter-spacing-wider: 0.05em;
  --we-letter-spacing-widest: 0.1em;
}"
`;

exports[`token CSS generation > size.css — sizes, radii, avatar sizes, component heights 1`] = `
"/* SIZE TOKENS - Generated from JS tokens */

:root {
  /* Component Sizes */
  --we-size-xxs: 0.75rem;
  --we-size-xs: 1rem;
  --we-size-sm: 1.5rem;
  --we-size-md: 2rem;
  --we-size-lg: 2.5rem;
  --we-size-xl: 3rem;
  --we-size-xxl: 4rem;

  /* Border Radius Sizes */
  --we-radius-0: 0;
  --we-radius-100: 0.125rem;
  --we-radius-200: 0.25rem;
  --we-radius-300: 0.375rem;
  --we-radius-400: 0.5rem;
  --we-radius-500: 0.75rem;
  --we-radius-600: 1rem;
  --we-radius-700: 1.25rem;
  --we-radius-800: 1.5rem;
  --we-radius-900: 2rem;
  --we-radius-pill: 9999px;
  --we-radius-full: 50%;

  /* Avatar Sizes */
  --we-avatar-size-xxs: 1rem;
  --we-avatar-size-xs: 1.5rem;
  --we-avatar-size-sm: 2rem;
  --we-avatar-size-md: 2.5rem;
  --we-avatar-size-lg: 3rem;
  --we-avatar-size-xl: 4rem;
  --we-avatar-size-xxl: 5rem;

  /* Component Heights */
  --we-component-height-xs: 1.5rem;
  --we-component-height-sm: 2rem;
  --we-component-height-md: 2.5rem;
  --we-component-height-lg: 3rem;
  --we-component-height-xl: 3.5rem;
}"
`;

exports[`token CSS generation > space.css 1`] = `
"/* SPACE TOKENS - Generated from JS tokens */

:root {
  /* Spacing Values */
  --we-space-0: 0rem;
  --we-space-100: calc(0.25rem * var(--we-theme-spacing-scale, 1));
  --we-space-200: calc(0.5rem * var(--we-theme-spacing-scale, 1));
  --we-space-300: calc(0.75rem * var(--we-theme-spacing-scale, 1));
  --we-space-400: calc(1rem * var(--we-theme-spacing-scale, 1));
  --we-space-500: calc(1.5rem * var(--we-theme-spacing-scale, 1));
  --we-space-600: calc(2rem * var(--we-theme-spacing-scale, 1));
  --we-space-700: calc(2.5rem * var(--we-theme-spacing-scale, 1));
  --we-space-800: calc(3rem * var(--we-theme-spacing-scale, 1));
  --we-space-900: calc(4rem * var(--we-theme-spacing-scale, 1));
  --we-space-1000: calc(6rem * var(--we-theme-spacing-scale, 1));
}"
`;

exports[`token CSS generation > z-index.css 1`] = `
"/* Z-INDEX TOKENS - Generated from JS tokens */

:root {
  /* Stacking Layers */
  --we-z-dropdown: 100;
  --we-z-sticky: 200;
  --we-z-chrome: 250;
  --we-z-modal: 300;
  --we-z-popover: 400;
  --we-z-toast: 500;
  --we-z-tooltip: 600;
}"
`;
