// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`token CSS generation > breakpoint.css — the tier thresholds 1`] = `
"/* BREAKPOINT TOKENS - Generated from JS tokens */

:root {
  /* Widths at which a layout may change arrangement — see src/breakpoint.ts */
  --we-breakpoint-sm: 640px;
  --we-breakpoint-md: 900px;
  --we-breakpoint-lg: 1200px;
}"
`;

exports[`token CSS generation > color.css — hues, lightness ramp, palettes, roles, gradient 1`] = `
"/* COLOR TOKENS - Generated from JS tokens */

:root {
  /* Color System Configuration */
  /* Unitless, so the chroma taper can be arithmetic on them. What a theme *states* is still a
     percentage — themeParametersToStyle converts on the way out. A backtick in this comment would end the
     template literal it lives in, which is the fifth time that has happened in this repo. */
  --we-color-lightness-floor: 0;
  --we-color-lightness-ceiling: 1;
  --we-color-ramp-offset: 0;
  --we-color-ramp-direction: 1;
  --we-state-hover: -0.05;
  --we-state-active: -0.09;
  --we-color-saturation: 60;
  --we-color-neutral-saturation: 10;
  --we-color-accent-saturation: var(--we-color-saturation);
  --we-color-success-saturation: var(--we-color-saturation);
  --we-color-warning-saturation: var(--we-color-saturation);
  --we-color-danger-saturation: var(--we-color-saturation);
  --we-color-red-saturation: var(--we-color-palette-saturation, var(--we-color-saturation));
  --we-color-orange-saturation: var(--we-color-palette-saturation, var(--we-color-saturation));
  --we-color-yellow-saturation: var(--we-color-palette-saturation, var(--we-color-saturation));
  --we-color-lime-saturation: var(--we-color-palette-saturation, var(--we-color-saturation));
  --we-color-green-saturation: var(--we-color-palette-saturation, var(--we-color-saturation));
  --we-color-teal-saturation: var(--we-color-palette-saturation, var(--we-color-saturation));
  --we-color-cyan-saturation: var(--we-color-palette-saturation, var(--we-color-saturation));
  --we-color-blue-saturation: var(--we-color-palette-saturation, var(--we-color-saturation));
  --we-color-purple-saturation: var(--we-color-palette-saturation, var(--we-color-saturation));
  --we-color-pink-saturation: var(--we-color-palette-saturation, var(--we-color-saturation));

  /* Color Hues */
  --we-color-neutral-hue: var(--we-color-accent-hue);
  --we-color-accent-hue: 288;
  --we-color-success-hue: 145;
  --we-color-warning-hue: 90;
  --we-color-danger-hue: 17;
  --we-color-red-hue: 25;
  --we-color-orange-hue: 55;
  --we-color-yellow-hue: 95;
  --we-color-lime-hue: 125;
  --we-color-green-hue: 150;
  --we-color-teal-hue: 185;
  --we-color-cyan-hue: 215;
  --we-color-blue-hue: 255;
  --we-color-purple-hue: 300;
  --we-color-pink-hue: 345;

  /* Lightness Scale */
  --we-color-lightness-0: calc(var(--we-color-lightness-floor) + (1 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-25: calc(var(--we-color-lightness-floor) + (0.98 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-50: calc(var(--we-color-lightness-floor) + (0.96 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-75: calc(var(--we-color-lightness-floor) + (0.945 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-100: calc(var(--we-color-lightness-floor) + (0.925 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-200: calc(var(--we-color-lightness-floor) + (0.845 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-300: calc(var(--we-color-lightness-floor) + (0.765 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-400: calc(var(--we-color-lightness-floor) + (0.685 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-500: calc(var(--we-color-lightness-floor) + (0.6 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-600: calc(var(--we-color-lightness-floor) + (0.51 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-700: calc(var(--we-color-lightness-floor) + (0.42 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-800: calc(var(--we-color-lightness-floor) + (0.32 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-900: calc(var(--we-color-lightness-floor) + (0.215 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));
  --we-color-lightness-1000: calc(var(--we-color-lightness-floor) + (0 - var(--we-color-ramp-offset)) * var(--we-color-ramp-direction) * (var(--we-color-lightness-ceiling) - var(--we-color-lightness-floor)));

  /* Neutral Colors */
  --we-color-neutral-0: oklch(var(--we-color-lightness-0) calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-0), 1 - var(--we-color-lightness-0)))) var(--we-color-neutral-hue));
  --we-color-neutral-25: oklch(var(--we-color-lightness-25) calc(var(--we-color-neutral-saturation) / 100 * var(--we-color-neutral-chroma-max, 0.18) * 2 * max(0, min(var(--we-color-lightness-25), 1 - var(--we-color-lightness-25)))) var(--we-color-neutral-hue));
