{
  "name": "@we/design-utils",
  "version": "0.1.0",
  "author": "James Weir",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "solid-js": "^1.9.15"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@we/cli": "workspace:*",
    "@we/design-types": "workspace:*",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.15",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@we/tokens": "workspace:*"
  }
}
