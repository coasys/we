{
  "name": "@we/components",
  "version": "0.1.0",
  "description": "Basic components for WE",
  "author": "James Weir",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./styles": {
      "import": "./dist/styles/index.css"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@we/design-utils": "workspace:*",
    "@we/tokens": "workspace:*",
    "codemirror": "^6.0.2"
  },
  "peerDependencies": {
    "@we/primitives": "^0.1.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@we/cli": "workspace:*",
    "@we/design-types": "workspace:*",
    "@we/primitives": "workspace:*",
    "@we/tokens": "workspace:*",
    "esbuild-plugin-solid": "^0.6.0",
    "jsdom": "^30.0.1",
    "sass": "^1.103.1",
    "solid-js": "^1.9.15",
    "tsup": "^8.5.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "context": {
    "type": "components"
  },
  "sideEffects": [
    "*.css"
  ]
}
