{
  "name": "@we/primitives",
  "version": "0.1.0",
  "description": "Web components for WE",
  "author": "James Weir",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:icons": "tsx scripts/collect-icons.ts",
    "build:cem": "cem analyze --litelement --config custom-elements-manifest.config.mjs --globs src/**/*.ts",
    "build:steps": "node scripts/check-super-calls.mjs && node scripts/generate-leaflet-css.mjs && pnpm build:icons && pnpm build:cem && tsup",
    "build": "we-build",
    "start": "pnpm build:cem && storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run --passWithNoTests"
  },
  "exports": {
    "./types": {
      "types": "./dist/types.ts"
    },
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/global/index.d.ts"
    },
    "./*": {
      "import": "./dist/primitives/*.js",
      "types": "./dist/types/global/primitives/*.d.ts"
    },
    "./react": {
      "import": "./dist/index.js",
      "types": "./dist/types/react/index.d.ts"
    },
    "./react/*": {
      "import": "./dist/primitives/*.js",
      "types": "./dist/types/react/primitives/*.d.ts"
    },
    "./react-jsx": {
      "import": "./dist/index.js",
      "types": "./dist/types/react-jsx/index.d.ts"
    },
    "./react-jsx/*": {
      "import": "./dist/primitives/*.js",
      "types": "./dist/types/react-jsx/primitives/*.d.ts"
    },
    "./react-jsxdev": {
      "import": "./dist/index.js",
      "types": "./dist/types/react-jsxdev/index.d.ts"
    },
    "./react-jsxdev/*": {
      "import": "./dist/primitives/*.js",
      "types": "./dist/types/react-jsxdev/primitives/*.d.ts"
    },
    "./svelte": {
      "import": "./dist/index.js",
      "types": "./dist/types/svelte/index.d.ts"
    },
    "./svelte/*": {
      "import": "./dist/primitives/*.js",
      "types": "./dist/types/svelte/primitives/*.d.ts"
    },
    "./solid": {
      "import": "./dist/index.js",
      "types": "./dist/types/solid/index.d.ts"
    },
    "./solid/*": {
      "import": "./dist/primitives/*.js",
      "types": "./dist/types/solid/primitives/*.d.ts"
    },
    "./solid/types": {
      "types": "./dist/types/solid/index.d.ts"
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@types/leaflet": "^1.9.21",
    "@we/design-utils": "workspace:*",
    "@we/tokens": "workspace:*",
    "jdenticon": "3.3.0",
    "leaflet": "^1.9.4",
    "dompurify": "^3.2.4",
    "lit": "3.2.1",
    "marked": "^18.0.0",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "solid-js": "^1.9.5"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.10.4",
    "@phosphor-icons/core": "^2.1.1",
    "@storybook/addon-essentials": "8.4.6",
    "@storybook/web-components": "8.4.6",
    "@storybook/web-components-vite": "8.4.6",
    "@types/node": "^24.10.0",
    "@we/cli": "workspace:*",
    "@we/design-types": "workspace:*",
    "eslint-plugin-lit": "^2.1.1",
    "prettier": "3.9.4",
    "storybook": "8.4.6",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "context": {
    "type": "primitives"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/types/global/index.d.ts"
      ],
      "/*": [
        "./dist/types/global/primitives/*.d.ts"
      ],
      "react": [
        "./dist/types/react/index.d.ts"
      ],
      "react/*": [
        "./dist/types/react/primitives/*.d.ts"
      ],
      "react-jsx": [
        "./dist/types/react-jsx/index.d.ts"
      ],
      "react-jsx/*": [
        "./dist/types/react-jsx/primitives/*.d.ts"
      ],
      "react-jsxdev": [
        "./dist/types/react-jsxdev/index.d.ts"
      ],
      "react-jsxdev/*": [
        "./dist/types/react-jsxdev/primitives/*.d.ts"
      ],
      "svelte": [
        "./dist/types/svelte/index.d.ts"
      ],
      "svelte/*": [
        "./dist/types/svelte/primitives/*.d.ts"
      ],
      "solid": [
        "./dist/types/solid/index.d.ts"
      ],
      "solid/*": [
        "./dist/types/solid/primitives/*.d.ts"
      ]
    }
  }
}
