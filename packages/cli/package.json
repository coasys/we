{
  "name": "@we/cli",
  "version": "0.1.0",
  "description": "CLI tools for WE",
  "author": "James Weir",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bootstrap": "tsup scripts/we-build.ts scripts/we-banner.ts --format esm --target es2022 --out-dir dist",
    "build:steps": "tsup",
    "build": "[ -f ./dist/we-build.js ] && node ./dist/we-build.js || pnpm run build:steps"
  },
  "bin": {
    "we-build": "./dist/we-build.js",
    "we-banner": "./dist/we-banner.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
