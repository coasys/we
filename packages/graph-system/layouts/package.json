{
  "name": "@we/graph-layouts",
  "version": "0.1.0",
  "description": "Layout strategies for the graph engine — force, radial, tree, grid and manual",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "d3-force": "^3.0.0"
  },
  "peerDependencies": {
    "@we/graph-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.4.0",
    "@we/cli": "workspace:*",
    "@we/graph-protocol": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
