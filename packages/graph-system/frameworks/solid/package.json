{
  "name": "@we/graph-solid",
  "version": "0.1.0",
  "description": "SolidJS renderer for the graph engine — DOM nodes, SVG edges, behaviour wiring",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:steps": "tsup && pnpm build:css",
    "build:css": "sass src/GraphView.scss dist/styles.css --no-source-map --style=compressed",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@we/graph-core": "workspace:*",
    "@we/graph-expanders": "workspace:*",
    "@we/graph-layouts": "workspace:*"
  },
  "peerDependencies": {
    "@we/components": "^0.1.0",
    "@we/design-utils": "workspace:*",
    "@we/graph-protocol": "workspace:*",
    "@we/primitives": "workspace:*",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@we/cli": "workspace:*",
    "@we/components": "workspace:*",
    "@we/design-utils": "workspace:*",
    "@we/graph-protocol": "workspace:*",
    "@we/primitives": "workspace:*",
    "esbuild-plugin-solid": "^0.6.0",
    "happy-dom": "^20.12.0",
    "sass": "^1.103.1",
    "solid-js": "^1.9.15",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "context": {
    "type": "widgets",
    "src": "src"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ]
}
