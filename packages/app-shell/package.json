{
  "name": "@we/app-shell",
  "version": "0.1.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate-templates": "node scripts/generateTemplateRegistry.mjs",
    "generate-views": "node scripts/generateViewRegistry.mjs",
    "publish-templates": "tsx scripts/publishTemplates.mjs",
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "bin": {
    "we-seed": "./dist/seed/cli.js"
  },
  "exports": {
    "./shared": {
      "import": "./dist/shared/index.js",
      "types": "./dist/shared/index.d.ts"
    },
    "./shared/index.scss": "./src/shared/index.scss",
    "./shared/*": {
      "import": "./dist/shared/*.js",
      "types": "./dist/shared/*.d.ts"
    },
    "./solid": {
      "import": "./src/frameworks/solid/index.ts",
      "types": "./src/frameworks/solid/index.ts"
    },
    "./seed": {
      "import": "./dist/seed/index.js",
      "types": "./dist/seed/index.d.ts"
    }
  },
  "dependencies": {
    "@coasys/ad4m": "0.13.0-test-interpretation-2",
    "@solidjs/router": "^0.15.3",
    "@we/ai-context": "workspace:*",
    "@we/backend-ad4m": "workspace:*",
    "@we/backend-shared": "workspace:*",
    "@we/block-shared": "workspace:*",
    "@we/block-solid": "workspace:*",
    "@we/components": "workspace:*",
    "@we/design-utils": "workspace:*",
    "@we/drag": "workspace:*",
    "@we/editor": "workspace:*",
    "@we/globe-widget": "workspace:*",
    "@we/graph-expanders": "workspace:*",
    "@we/graph-protocol": "workspace:*",
    "@we/graph-solid": "workspace:*",
    "@we/entities": "workspace:*",
    "@we/module-call": "workspace:*",
    "@we/module-globe": "workspace:*",
    "@we/module-graph": "workspace:*",
    "@we/module-notes": "workspace:*",
    "@we/module-pocket": "workspace:*",
    "@we/module-shared": "workspace:*",
    "@we/module-transcribe": "workspace:*",
    "@we/primitives": "workspace:*",
    "@we/schema-kit": "workspace:*",
    "@we/schema-shared": "workspace:*",
    "@we/schema-solid": "workspace:*",
    "@we/template-default": "workspace:*",
    "@we/template-shell": "workspace:*",
    "@we/template-showcase": "workspace:*",
    "@we/template-views": "workspace:*",
    "@we/themes": "workspace:*",
    "@we/tokens": "workspace:*",
    "@we/widgets": "workspace:*",
    "lib0": "^0.2.117",
    "solid-js": "^1.9.15",
    "three": "^0.185.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^26.3.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@we/backend-inmemory": "workspace:*",
    "@we/cli": "workspace:*",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
