{
  "private": true,
  "name": "@we/acorn-fixture",
  "version": "0.1.0",
  "description": "An in-memory dataset shaped like a mounted Acorn project — the Acorn vocabulary as an EntityManifest, one project's records, and the applyFixture wrapper that writes them",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "dependencies": {
    "@we/backend-inmemory": "workspace:*",
    "@we/backend-shared": "workspace:*",
    "@we/entities": "workspace:*",
    "@we/template-fixtures": "workspace:*"
  },
  "devDependencies": {
    "@coasys/ad4m": "*",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
