{
  "name": "@we/models",
  "version": "0.1.0",
  "description": "Shared WE models \u2014 WeNode base class and entity models",
  "author": "James Weir",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:types": "tsx scripts/generateTypes.mjs"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./manifest": {
      "import": "./dist/manifest/index.js",
      "require": "./dist/manifest/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {},
  "devDependencies": {
    "@we/cli": "workspace:*",
    "tsup": "^8.5.1",
    "vitest": "^4.0.15",
    "tsx": "^4.21.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "context": {
    "type": "models"
  },
  "dependencies": {
    "@we/backend-shared": "workspace:*"
  }
}
