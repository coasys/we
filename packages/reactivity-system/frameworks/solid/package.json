{
  "name": "@we/reactivity-solid",
  "version": "0.1.0",
  "description": "The reactivity port implemented by Solid — what a Solid host hands a store",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
