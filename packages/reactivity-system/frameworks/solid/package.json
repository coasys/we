  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@we/reactivity": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@we/cli": "workspace:*",
    "happy-dom": "^21.0.4",
    "solid-js": "^1.9.18",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "sideEffects": false
}
