{
  "schemaVersion": "1.0.0",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "components/rating/rating.js",
      "declarations": [
        {
          "kind": "class",
          "name": "XRating",
          "customElement": true,
          "tagName": "x-rating",
          "summary": "A row of stars somebody picks from.",
          "members": [
            { "kind": "field", "name": "value", "type": { "text": "number" }, "default": "0" },
            { "kind": "field", "name": "max", "type": { "text": "number" }, "default": "5" },
            { "kind": "field", "name": "_hovered", "type": { "text": "number" }, "privacy": "private" },
            { "kind": "field", "name": "styles", "static": true },
            { "kind": "field", "name": "version", "readonly": true },
            { "kind": "method", "name": "focus" }
          ],
          "attributes": [
            { "name": "value", "fieldName": "value", "type": { "text": "number" } },
            { "name": "label", "type": { "text": "string" } }
          ],
          "events": [{ "name": "x-change" }, { "name": "x-hover" }]
        },
        { "kind": "class", "name": "Helper" }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "components/chart/chart.js",
      "declarations": [
        { "kind": "class", "name": "XChart", "customElement": true, "tagName": "x-chart", "members": [] }
      ]
    }
  ]
}
