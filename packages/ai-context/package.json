{
  "name": "@we/ai-context",
  "version": "0.1.0",
  "description": "Auto-extracted AI context for schema generation — instruction files + runtime constant",
  "type": "module",
  "scripts": {
    "build:steps": "tsx src/generate.ts && tsup",
    "build": "we-build",
    "generate-context": "tsx src/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@we/design-utils": "workspace:*",
    "@we/schema-shared": "workspace:*",
    "@we/models": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@we/cli": "workspace:*",
    "prettier": "3.9.6",
    "ts-morph": "^28.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
