{
  "name": "@we/ai-context",
  "version": "0.1.0",
  "description": "Auto-extracted AI context for schema generation — instruction files + runtime constant",
  "type": "module",
  "scripts": {
    "build:steps": "tsx src/generate.ts && tsup",
    "build": "we-build",
    "generate-context": "tsx src/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@we/design-utils": "workspace:*",
    "@we/entities": "workspace:*",
    "@we/schema-shared": "workspace:*",
    "@we/themes": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@we/cli": "workspace:*",
    "@we/module-call": "workspace:*",
    "@we/module-feed": "workspace:*",
    "@we/module-globe": "workspace:*",
    "@we/module-flux": "workspace:*",
    "@we/module-graph": "workspace:*",
    "@we/module-live": "workspace:*",
    "@we/module-notes": "workspace:*",
    "@we/module-pocket": "workspace:*",
    "@we/module-polls": "workspace:*",
    "@we/module-shared": "workspace:*",
    "@we/module-transcribe": "workspace:*",
    "prettier": "3.9.10",
    "ts-morph": "^28.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "sideEffects": false
}
