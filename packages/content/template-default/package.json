{
  "name": "@we/template-default",
  "version": "0.1.0",
  "description": "WE's built-in space templates \u2014 shipped as data, versioned independently of the framework that renders them",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@we/schema-shared": "workspace:*",
    "@we/template-shell": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@we/cli": "workspace:*",
    "tsup": "^8.5.1"
  },
  "sideEffects": false
}
