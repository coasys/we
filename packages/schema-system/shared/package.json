{
  "name": "@we/schema-shared",
  "version": "0.1.0",
  "description": "Framework-agnostic schema types, validators, and prop resolvers for WE",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "types": "dist/index.d.ts",
