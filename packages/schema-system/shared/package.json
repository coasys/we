{
  "name": "@we/schema-shared",
  "version": "0.1.0",
  "description": "Framework-agnostic schema types, validators, and prop resolvers for WE",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "validate": "tsx src/cli/we-validate-schemas.ts ../../app-shell/src/shared/schemas/ ../../templates/shell/src/ ../../templates/default/src/ ../../templates/views/src/ ../../templates/showcase/src/ ../../module-system/",
    "surface-audit": "tsx src/cli/surface-audit.ts ../../templates ../../app-shell/src/shared/schemas ../../module-system",
    "role-audit": "tsx src/cli/role-audit.ts ../../templates ../../app-shell/src/shared/schemas ../../module-system"
  },
  "bin": {
    "we-validate-schemas": "./dist/cli/we-validate-schemas.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@we/backend-shared": "workspace:*",
    "@we/design-utils": "workspace:*",
    "@we/themes": "workspace:*",
    "@we/tokens": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@we/cli": "workspace:*",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
