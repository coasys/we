    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.15",
    "@we/cli": "workspace:*",
    "jsdom": "^27.2.0",
    "tsup": "^8.5.1",
    "vitest": "^4.0.15"
  },
  "sideEffects": false
}
