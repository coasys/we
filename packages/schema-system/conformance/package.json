{
  "private": true,
  "name": "@we/template-conformance",
  "version": "0.1.0",
  "description": "Recorded input → expected-output vectors for WE's template language — the contract the Rust renderer must satisfy, produced by the real TypeScript implementation",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "record": "tsx src/record.ts && vitest run --config vitest.config.record.ts",
    "record:tokens": "tsx src/recordTokens.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@we/schema-shared": "workspace:*",
    "@we/design-utils": "workspace:*"
  },
  "devDependencies": {
    "@solidjs/router": "^0.16.3",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^26.6.6",
    "@we/app-shell": "workspace:*",
    "@we/themes": "workspace:*",
    "@we/tokens": "workspace:*",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "jsdom": "~30.0.1",
    "playwright-core": "^1.64.1",
    "sass": "^1.107.1",
    "solid-js": "^1.9.10",
    "tsx": "^4.23.15",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.0.5"
  }
}
