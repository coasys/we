      "id": "rdf.minimal",
      "note": "a node is a blank node typed by its `type` in the we: vocabulary; text children are an rdf:List of literals",
      "template": {
        "schemaVersion": 1,
        "meta": {
          "name": "Case",
          "description": "An RDF case",
          "icon": "graph"
        },
        "type": "Column",
        "children": ["Hello", "world"]
      },
      "nquads": [
        "_:c14n0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://we.example/ns/template#Column> .",
        "_:c14n0 <https://we.example/ns/template#children> _:c14n1 .",
        "_:c14n0 <https://we.example/ns/template#meta> \"{\\\"description\\\":\\\"An RDF case\\\",\\\"icon\\\":\\\"graph\\\",\\\"name\\\":\\\"Case\\\"}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
        "_:c14n0 <https://we.example/ns/template#schemaVersion> \"1\"^^<http://www.w3.org/2001/XMLSchema#integer> .",
        "_:c14n1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> \"Hello\" .",
