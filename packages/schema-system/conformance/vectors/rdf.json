        "_:c14n4 <https://we.example/ns/template#meta> \"{\\\"description\\\":\\\"An RDF case\\\",\\\"icon\\\":\\\"graph\\\",\\\"name\\\":\\\"Case\\\"}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
