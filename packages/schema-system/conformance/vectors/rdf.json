    {
      "id": "rdf.styles-theme-fork",
      "note": "styles and theme are JSON literals; the editing bookkeeping is literals of its own",
      "template": {
        "schemaVersion": 1,
        "meta": {
          "name": "Case",
          "description": "An RDF case",
          "icon": "graph"
        },
        "type": "Column",
        "forkedFrom": "d1",
        "styles": {
          "filter": "blur(2px)"
        },
        "theme": {
          "themeName": "dark"
        },
        "children": []
      },
      "nquads": [
        "_:c14n0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://we.example/ns/template#Column> .",
