    {
      "id": "rdf.values-are-json",
      "note": "props, local state and queries are rdf:JSON literals, expressions and nulls inside them kept as written",
      "template": {
        "schemaVersion": 1,
        "meta": {
          "name": "Case",
          "description": "An RDF case",
          "icon": "graph"
        },
        "type": "Column",
        "$localState": {
          "open": {
            "type": "boolean",
            "initial": false
          }
        },
        "$queries": {
          "posts": {
            "entity": "Post",
            "limit": 5
          }
        },
        "props": {
          "gap": "300",
          "label": {
            "$": "local.open ? \"Close\" : \"Open\""
          },
          "items": [1, null, "a"]
        },
        "children": []
      },
      "nquads": [
        "_:c14n0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://we.example/ns/template#Column> .",
        "_:c14n0 <https://we.example/ns/template#children> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .",
        "_:c14n0 <https://we.example/ns/template#localState> \"{\\\"open\\\":{\\\"initial\\\":false,\\\"type\\\":\\\"boolean\\\"}}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
        "_:c14n0 <https://we.example/ns/template#meta> \"{\\\"description\\\":\\\"An RDF case\\\",\\\"icon\\\":\\\"graph\\\",\\\"name\\\":\\\"Case\\\"}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
        "_:c14n0 <https://we.example/ns/template#props> \"{\\\"gap\\\":\\\"300\\\",\\\"items\\\":[1,null,\\\"a\\\"],\\\"label\\\":{\\\"$\\\":\\\"local.open ? \\\\\\\"Close\\\\\\\" : \\\\\\\"Open\\\\\\\"\\\"}}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
        "_:c14n0 <https://we.example/ns/template#queries> \"{\\\"posts\\\":{\\\"entity\\\":\\\"Post\\\",\\\"limit\\\":5}}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
        "_:c14n0 <https://we.example/ns/template#schemaVersion> \"1\"^^<http://www.w3.org/2001/XMLSchema#integer> ."
      ]
    },
    {
      "id": "rdf.expression-child",
      "note": "an expression in children is a node holding its source as a literal of we:expression",
      "template": {
        "schemaVersion": 1,
        "meta": {
          "name": "Case",
          "description": "An RDF case",
          "icon": "graph"
        },
        "type": "we-text",
        "children": [
          "n = ",
          {
            "$": "count(local.rows)"
          }
        ]
      },
      "nquads": [
        "_:c14n0 <https://we.example/ns/template#expression> \"count(local.rows)\" .",
        "_:c14n1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://we.example/ns/template#we-text> .",
        "_:c14n1 <https://we.example/ns/template#children> _:c14n3 .",
