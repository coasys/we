    {
      "id": "rdf.values-are-json",
      "note": "local state and queries are rdf:JSON literals; a prop is a triple of its own: text a literal, an expression a node, a list an rdf:List whose null is a JSON literal",
      "template": {
        "schemaVersion": 1,
        "meta": {
          "name": "Case",
          "description": "An RDF case",
          "icon": "graph"
        },
        "type": "Column",
        "$localState": {
          "open": {
            "type": "boolean",
            "initial": false
          }
        },
        "$queries": {
          "posts": {
            "entity": "Post",
            "limit": 5
          }
        },
        "props": {
          "gap": "300",
          "label": {
            "$": "local.open ? \"Close\" : \"Open\""
          },
          "items": [1, null, "a"]
        },
        "children": []
      },
      "nquads": [
        "_:c14n0 <https://we.example/ns/template#expression> \"local.open ? \\\"Close\\\" : \\\"Open\\\"\" .",
