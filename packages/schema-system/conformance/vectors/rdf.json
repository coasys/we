        "_:c14n0 <https://we.example/ns/template#forkedFrom> \"d1\" .",
        "_:c14n0 <https://we.example/ns/template#meta> \"{\\\"description\\\":\\\"An RDF case\\\",\\\"icon\\\":\\\"graph\\\",\\\"name\\\":\\\"Case\\\"}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
        "_:c14n0 <https://we.example/ns/template#schemaVersion> \"1\"^^<http://www.w3.org/2001/XMLSchema#integer> .",
        "_:c14n0 <https://we.example/ns/template#styles> \"{\\\"filter\\\":\\\"blur(2px)\\\"}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
        "_:c14n0 <https://we.example/ns/template#theme> \"{\\\"themeName\\\":\\\"dark\\\"}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> ."
      ]
    },
    {
      "id": "rdf.props-as-triples",
      "note": "each prop is one triple under we:prop/<name>, a name like a key of the format included; a number and a boolean are typed literals, data and an empty props one JSON literal each, a token a node, and a node in a node prop a node",
      "template": {
        "schemaVersion": 1,
        "meta": {
          "name": "Case",
          "description": "An RDF case",
          "icon": "graph"
        },
        "type": "Column",
        "props": {
          "gap": 300,
          "wrap": false,
          "type": "email",
          "id": "field",
          "options": {
            "a": [1, 2]
          }
        },
        "children": [
          {
            "type": "we-divider",
            "props": {}
          },
          {
            "type": "$each",
            "props": {
              "items": {
                "$query": {
                  "entity": "Post",
                  "limit": 3
                }
              },
              "as": "post"
            },
            "children": [
              {
                "type": "we-text",
                "children": [
                  {
                    "$": "post.title"
                  }
                ]
              }
            ]
          },
          {
            "type": "$if",
            "props": {
              "condition": {
                "$": "local.open"
              },
              "then": {
                "type": "we-text",
                "props": {
                  "variant": "caption"
                },
                "children": ["open"]
              }
            }
          },
          {
            "type": "we-button",
            "props": {
              "label": "Go",
              "onClick": {
                "$navigate": {
                  "to": "/board"
                }
              }
            }
          }
        ]
      },
      "nquads": [
        "_:c14n0 <https://we.example/ns/template#expression> \"local.open\" .",
        "_:c14n1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://we.example/ns/template#$if> .",
        "_:c14n1 <https://we.example/ns/template#props> _:c14n6 .",
        "_:c14n10 <https://we.example/ns/template#$query> \"{\\\"entity\\\":\\\"Post\\\",\\\"limit\\\":3}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
        "_:c14n11 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> _:c14n9 .",
        "_:c14n11 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .",
        "_:c14n12 <https://we.example/ns/template#prop/variant> \"caption\" .",
