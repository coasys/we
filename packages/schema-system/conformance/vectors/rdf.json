    {
      "id": "rdf.every-position",
      "note": "children, routes, slots, $defs and a $ref each become triples; a slot or a shape keeps its name as we:slotName or we:defName",
      "template": {
        "schemaVersion": 1,
        "meta": {
          "name": "Case",
          "description": "An RDF case",
          "icon": "graph",
          "panels": [
            {
              "id": "side",
              "node": {
                "type": "we-text",
                "children": ["panel"]
              }
            }
          ]
        },
        "type": "Column",
        "id": "root",
        "$defs": {
          "d1": {
            "type": "Card",
            "children": ["shared"]
          }
        },
        "children": [
          {
            "type": "$ref",
            "props": {
              "def": "d1"
            }
          },
          {
            "type": "Card",
            "key": "k1",
            "slots": {
              "header": {
                "type": "Row",
                "children": ["head"]
              }
            }
          },
          {
            "type": "we-tab",
            "slot": "nav",
            "children": ["A"]
          },
          {
            "type": "FlipCard",
            "props": {
              "front": {
                "type": "Card",
                "children": ["front"]
              }
            }
          },
          {
            "type": "$routes"
          }
        ],
        "routes": [
          {
            "path": "/",
            "type": "Column",
            "keepAlive": true,
            "children": ["home"]
          },
          {
            "path": "/old",
            "redirect": "/"
          },
          {
            "path": "/board",
            "type": "Column",
            "children": [
              {
                "type": "$routes"
              }
            ],
            "routes": [
              {
                "path": "/",
                "type": "Row"
              }
            ]
          }
        ]
      },
      "nquads": [
        "_:c14n0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> _:c14n26 .",
        "_:c14n0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .",
        "_:c14n1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://we.example/ns/template#FlipCard> .",
