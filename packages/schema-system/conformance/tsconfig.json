{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // The recorder runs under tsx, which reads these paths: schema-shared's src imports the
    // expression language by package name, and it must be the same src copy the recorder uses.
    "paths": { "@we/expressions": ["../expressions/src/index.ts"] }
  },
  "include": ["src", "tests", "*.config.ts", "../app-shell/tests/support/recordNavigation.ts"],
  "exclude": ["node_modules", "dist"]
}
