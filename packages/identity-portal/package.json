{
  "name": "@coasys/identity-portal",
  "version": "0.1.0",
  "description": "The identity screens, shared by the desktop and phone identity windows and the Connect frame on coasys.id: the custody flows, the device list and Link this browser",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.js"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "vite.js",
    "vite.d.ts",
    "csp.txt"
  ],
  "dependencies": {
    "@we/themes": "workspace:*",
    "@we/tokens": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
