{
  "name": "@we/block-shared",
  "version": "0.1.0",
  "description": "Shared types and serialization for the WE block system",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@we/design-types": "workspace:*",
    "@we/models": "workspace:*",
    "@we/backend-shared": "workspace:*"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@we/cli": "workspace:*",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
