{
  "name": "@we/backend-conformance",
  "version": "0.1.0",
  "description": "One test suite every backend runs — the contract's behaviour, asserted the same way against each implementation",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "typecheck": "tsc --noEmit",
    "record:operations": "tsx scripts/recordOperationVectors.ts",
    "test": "vitest run",
    "record:suites": "tsx scripts/recordOperationSuites.ts"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@we/backend-shared": "workspace:*",
    "@we/entities": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@types/jsonld": "^1.5.15",
    "@types/node": "^26.6.6",
    "@we/cli": "workspace:*",
    "@we/expressions": "workspace:*",
    "jsonld": "^8.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "sideEffects": false
}
