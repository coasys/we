    {
      "id": "rdf.identity-scope-call",
      "note": "an identity is an rdf:List of field names; a scope is a node; a call names what it calls; serial and when are JSON literals",
      "document": {
        "version": "1",
        "operations": {
          "ensureState": {
            "description": "A task state for the slug, then the records under a board.",
            "params": {
              "slug": { "type": "string", "required": true },
              "board": { "type": "string", "required": true }
            },
            "serial": { "$": "'state ' + slug" },
            "steps": [
              {
                "create": {
                  "as": "state",
                  "entity": "TaskState",
                  "identity": ["slug"],
                  "fields": { "slug": { "$": "slug" } }
                }
              },
              {
                "find": {
                  "as": "cards",
                  "entity": "CollectionBlock",
                  "scope": {
                    "anchor": "CollectionBlock",
                    "via": "children",
                    "anchorId": { "$": "board" },
                    "levels": [10, 5]
                  },
                  "order": { "createdAt": "desc" },
                  "limit": 20
                }
              },
              {
                "call": { "as": "done", "operation": "core.thread", "args": { "node": { "$": "board" } } },
                "when": false
              }
            ]
          }
        }
      },
      "nquads": [
