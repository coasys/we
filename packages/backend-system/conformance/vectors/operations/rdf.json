  "cases": [
    {
      "id": "rdf.make-board",
      "note": "an operation is a node named in its manifest; its steps an rdf:List, each a node under its verb; values rdf:JSON literals, expressions kept inside them",
      "document": {
        "version": "1",
        "operations": {
          "makeBoard": {
            "description": "A board and a column under it for each column given.",
            "params": {
              "title": { "type": "string", "required": true },
              "columns": { "type": "list", "required": true }
            },
            "errors": { "untitled": "A board needs a title." },
            "steps": [
              { "check": { "condition": { "$": "trim(title) != ''" }, "error": "untitled" } },
              {
                "create": {
                  "as": "board",
                  "entity": "CollectionBlock",
                  "fields": { "kind": "board", "title": { "$": "title" } }
                }
              },
              {
                "forEach": {
                  "in": { "$": "columns" },
                  "as": "col",
                  "steps": [
                    {
                      "create": {
                        "as": "column",
                        "entity": "CollectionBlock",
                        "fields": { "kind": "column", "title": { "$": "col.title" } }
                      }
                    },
                    {
                      "link": {
                        "entity": "CollectionBlock",
                        "id": { "$": "board.id" },
                        "relation": "children",
                        "target": { "$": "column.id" }
                      }
                    }
                  ]
                }
              }
            ],
            "returns": { "$": "board.id" }
          }
        }
      },
      "nquads": [
        "_:c14n0 <https://we.example/ns/operations#description> \"A board and a column under it for each column given.\" .",
        "_:c14n0 <https://we.example/ns/operations#errors> \"{\\\"untitled\\\":\\\"A board needs a title.\\\"}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
        "_:c14n0 <https://we.example/ns/operations#name> \"makeBoard\" .",
        "_:c14n0 <https://we.example/ns/operations#params> \"{\\\"columns\\\":{\\\"required\\\":true,\\\"type\\\":\\\"list\\\"},\\\"title\\\":{\\\"required\\\":true,\\\"type\\\":\\\"string\\\"}}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
        "_:c14n0 <https://we.example/ns/operations#returns> \"{\\\"$\\\":\\\"board.id\\\"}\"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON> .",
