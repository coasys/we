          "description": "A case.",
          "steps": [{ "forEach": { "in": [{ "title": "a" }], "as": "x", "steps": [] } }]
        }
      },
      "refused": true,
      "paths": ["operations.t.steps.0.forEach.in.0"]
    },
    {
      "id": "static.identity-ok",
      "check": 14,
      "note": "an identity over a property and a to-one, both given: nothing to refuse",
      "operations": {
        "t": {
          "description": "A case.",
          "steps": [
            {
              "create": {
                "entity": "Board",
                "identity": ["title", "lead"],
                "fields": { "title": "Plan", "lead": "c1" }
              }
            }
          ]
        }
      },
      "refused": false,
      "paths": []
