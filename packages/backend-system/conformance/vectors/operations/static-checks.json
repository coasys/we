        "operations.t.steps.3.create.identity.0"
      ]
    },
    {
      "id": "static.serial-literal",
      "check": 15,
      "note": "a serial that is not an expression",
      "operations": {
        "t": { "description": "A case.", "steps": [], "serial": "board", "params": { "board": { "type": "string" } } }
