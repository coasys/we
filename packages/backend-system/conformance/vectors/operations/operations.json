    {
      "id": "core-upsert-signal",
      "note": "core.upsertSignal with no reaction yet makes one under the record, and answers with its id",
      "manifest": {
        "version": "1",
        "entities": {},
        "operations": {
          "upsertSignal": {
            "description": "Give the invoker’s reaction of one type on a record, or change it: one per person per type, edited in place, any duplicates removed.",
            "params": {
              "node": {
                "type": "string",
                "required": true,
                "description": "The record reacted to."
              },
              "signalType": {
                "type": "string",
                "required": true,
                "description": "The SignalType’s id."
              },
              "value": {
                "type": "number",
                "required": true,
                "description": "What the reaction says. Zero is a value like any other; withdrawing is withdrawSignal."
              }
            },
            "steps": [
              {
                "find": {
                  "as": "mine",
                  "entity": "Signal",
                  "scope": {
                    "anchor": "WeNode",
                    "via": "signals",
                    "anchorId": {
                      "$": "node"
                    }
                  },
                  "where": {
                    "signalTypeId": {
                      "$": "signalType"
                    },
                    "author": {
                      "$": "invoker"
                    }
                  },
                  "order": {
                    "createdAt": "asc"
                  }
                }
              },
              {
                "create": {
                  "as": "made",
                  "entity": "Signal",
                  "fields": {
                    "signalTypeId": {
                      "$": "signalType"
                    },
                    "value": {
                      "$": "value"
                    }
                  },
                  "parent": {
                    "id": {
                      "$": "node"
                    },
                    "relation": "signals"
                  }
                },
                "when": {
                  "$": "count(mine) == 0"
                }
              },
              {
                "update": {
                  "entity": "Signal",
                  "id": {
                    "$": "first(mine)"
                  },
                  "fields": {
                    "value": {
                      "$": "value"
                    }
                  }
                },
                "when": {
                  "$": "count(mine) > 0"
                }
              },
              {
                "forEach": {
                  "in": {
                    "$": "slice(mine, 1)"
                  },
                  "as": "extra",
                  "steps": [
                    {
                      "delete": {
                        "entity": "Signal",
                        "id": {
                          "$": "extra"
                        }
                      }
                    }
                  ]
                }
              }
            ],
            "returns": {
              "$": "count(mine) ? first(mine).id : made.id"
            }
          }
        }
      },
      "dataset": [
        {
          "entity": "CollectionBlock",
          "id": "urn:example:post",
          "fields": {
            "kind": "post"
          }
        }
      ],
      "operation": "upsertSignal",
      "args": {
        "node": "urn:example:post",
        "signalType": "urn:example:like",
        "value": 0
      },
      "invoker": "did:example:invoker",
      "invocationId": "00000000-0000-4000-8000-000000000007",
      "invokedAt": "2026-11-24T00:00:00.000Z",
      "observe": [
        {
          "entity": "CollectionBlock",
          "fields": ["kind"],
          "relations": ["signals"]
        },
        {
          "entity": "Signal",
          "fields": ["signalTypeId", "value"],
          "relations": []
        }
      ],
      "outcome": {
        "result": "urn:uuid:e5a8884b-ad96-85aa-b280-93762a318687"
      },
      "records": {
        "CollectionBlock": [
          {
            "id": "urn:example:post",
            "kind": "post",
            "signals": ["urn:uuid:e5a8884b-ad96-85aa-b280-93762a318687"]
          }
        ],
        "Signal": [
          {
            "id": "urn:uuid:e5a8884b-ad96-85aa-b280-93762a318687",
            "signalTypeId": "urn:example:like",
            "value": 0
          }
        ]
      }
