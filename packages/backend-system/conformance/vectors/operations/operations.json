    {
      "id": "strict-link",
      "note": "a strict link to a record already linked fails as alreadyLinked and changes nothing",
      "manifest": {
        "version": "1",
        "entities": {},
        "operations": {
          "adopt": {
            "description": "Puts a record under another, strictly: refused when it is there already.",
            "params": {
              "parent": {
                "type": "string",
                "required": true
              },
              "child": {
                "type": "string",
                "required": true
              }
            },
            "steps": [
              {
                "link": {
                  "entity": "CollectionBlock",
                  "id": {
                    "$": "parent"
                  },
                  "relation": "children",
                  "target": {
                    "$": "child"
                  },
                  "strict": true
                }
              }
            ]
          }
        }
      },
      "dataset": [
        {
          "entity": "CollectionBlock",
          "id": "urn:example:child",
          "fields": {
            "kind": "card"
          }
        },
        {
          "entity": "CollectionBlock",
          "id": "urn:example:parent",
          "fields": {
            "kind": "board"
          },
          "relations": {
            "children": ["urn:example:child"]
          }
        }
      ],
      "operation": "adopt",
      "args": {
        "parent": "urn:example:parent",
        "child": "urn:example:child"
      },
      "invoker": "did:example:invoker",
      "invocationId": "00000000-0000-4000-8000-000000000006",
      "invokedAt": "2026-11-24T00:00:00.000Z",
      "observe": [
        {
          "entity": "CollectionBlock",
          "fields": ["kind", "title", "slug"],
          "relations": ["children"]
        }
      ],
      "outcome": {
        "error": {
          "class": "precondition",
          "code": "alreadyLinked"
        }
      },
      "records": {
        "CollectionBlock": [
          {
            "id": "urn:example:child",
            "kind": "card"
          },
          {
            "id": "urn:example:parent",
