    {
      "id": "upsert-existing",
      "note": "a find that matches skips the guarded create, and the operation returns what it found",
      "manifest": {
        "version": "1",
        "entities": {},
        "operations": {
          "ensureTag": {
            "description": "The tag with this slug, made when there is none.",
            "params": {
              "slug": {
                "type": "string",
                "required": true
              }
            },
            "steps": [
              {
                "find": {
                  "as": "found",
                  "entity": "CollectionBlock",
                  "where": {
                    "kind": "tag",
                    "slug": {
                      "$": "slug"
                    }
                  }
                }
              },
              {
                "create": {
                  "as": "made",
                  "entity": "CollectionBlock",
                  "fields": {
                    "kind": "tag",
                    "slug": {
                      "$": "slug"
                    }
                  }
                },
                "when": {
                  "$": "count(found) == 0"
                }
              }
            ],
            "returns": {
              "$": "count(found) ? first(found).id : made.id"
            }
          }
        }
      },
      "dataset": [
        {
          "entity": "CollectionBlock",
          "id": "urn:example:tag-garden",
          "fields": {
            "kind": "tag",
            "slug": "garden"
          }
        }
      ],
      "operation": "ensureTag",
      "args": {
        "slug": "garden"
      },
      "invoker": "did:example:invoker",
      "invocationId": "00000000-0000-4000-8000-000000000002",
      "invokedAt": "2026-11-24T00:00:00.000Z",
      "observe": [
        {
          "entity": "CollectionBlock",
          "fields": ["kind", "title", "slug"],
          "relations": ["children"]
        }
      ],
      "outcome": {
        "result": "urn:example:tag-garden"
      },
      "records": {
        "CollectionBlock": [
          {
            "id": "urn:example:tag-garden",
            "kind": "tag",
            "slug": "garden"
          }
        ]
