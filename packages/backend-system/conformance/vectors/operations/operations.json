    {
      "id": "core-respond-replaces",
      "note": "core.respond removes the answer the invoker gave before, on this record only, and makes the new one",
      "manifest": {
        "version": "1",
        "entities": {},
        "operations": {
          "respond": {
            "description": "Give the invoker’s own answer to a record — going, maybe, not going — replacing any answer they gave before; with no kind, withdraw it.",
            "params": {
              "node": {
                "type": "string",
                "required": true,
                "description": "The record answered."
              },
              "kind": {
                "type": "string",
                "description": "A reflexive InvolvementType’s slug; absent withdraws the answer."
              }
            },
            "errors": {
              "notAnAnswer": "That is not an answer anybody can give to this."
            },
            "steps": [
              {
                "find": {
                  "as": "answers",
                  "entity": "InvolvementType",
                  "where": {
                    "reflexive": true
                  }
                }
              },
              {
                "check": {
                  "condition": {
                    "$": "!kind || kind in answers.map(t, t.slug)"
                  },
                  "error": "notAnAnswer"
                }
              },
              {
                "find": {
                  "as": "held",
                  "entity": "Involvement",
                  "where": {
                    "agent": {
                      "$": "invoker"
                    },
                    "kind": {
                      "$": "answers.map(t, t.slug)"
                    }
                  }
                }
              },
              {
                "forEach": {
                  "in": {
                    "$": "held.filter(r, (r.node == node || node in r.node) && r.kind != kind)"
                  },
                  "as": "stale",
                  "steps": [
                    {
                      "delete": {
                        "entity": "Involvement",
                        "id": {
                          "$": "stale"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "create": {
                  "entity": "Involvement",
                  "fields": {
                    "agent": {
                      "$": "invoker"
                    },
                    "kind": {
                      "$": "kind"
                    },
                    "node": [
                      {
                        "$": "node"
                      }
                    ]
                  }
                },
                "when": {
                  "$": "kind && !held.exists(r, (r.node == node || node in r.node) && r.kind == kind)"
                }
              }
            ]
          }
        }
      },
      "dataset": [
        {
          "entity": "InvolvementType",
          "id": "urn:example:going",
          "fields": {
            "name": "Going",
            "slug": "going",
            "reflexive": true
          }
        },
        {
          "entity": "InvolvementType",
          "id": "urn:example:maybe",
          "fields": {
            "name": "Maybe",
            "slug": "maybe",
            "reflexive": true
          }
        },
        {
          "entity": "Involvement",
          "id": "urn:example:said-maybe",
          "fields": {
            "agent": "did:example:invoker",
            "kind": "maybe",
            "node": ["urn:example:event"]
          }
        },
        {
          "entity": "Involvement",
          "id": "urn:example:other-event",
          "fields": {
            "agent": "did:example:invoker",
            "kind": "maybe",
            "node": ["urn:example:elsewhere"]
          }
        }
      ],
      "operation": "respond",
      "args": {
        "node": "urn:example:event",
        "kind": "going"
      },
      "invoker": "did:example:invoker",
      "invocationId": "00000000-0000-4000-8000-000000000008",
      "invokedAt": "2026-11-24T00:00:00.000Z",
      "observe": [
        {
          "entity": "Involvement",
          "fields": ["agent", "kind"],
          "relations": []
        }
      ],
      "outcome": {
        "result": null
      },
      "records": {
        "Involvement": [
          {
            "id": "urn:example:other-event",
            "agent": "did:example:invoker",
            "kind": "maybe"
          },
          {
