    {
      "id": "rollback-on-check",
      "note": "a failed check fails the operation with its named error, and the record made before it does not land",
      "manifest": {
        "version": "1",
        "entities": {},
        "operations": {
          "guarded": {
            "description": "Makes a note, checks, and makes another — so a failed check must take the first back.",
            "params": {
              "n": {
                "type": "number",
                "required": true
              }
            },
            "errors": {
              "tooBig": "The number is too big."
            },
            "steps": [
              {
                "create": {
                  "entity": "CollectionBlock",
                  "fields": {
                    "kind": "note",
                    "title": "before"
                  }
                }
              },
              {
                "check": {
                  "condition": {
                    "$": "n < 10"
                  },
                  "error": "tooBig"
                }
              },
              {
                "create": {
                  "entity": "CollectionBlock",
                  "fields": {
                    "kind": "note",
                    "title": "after"
                  }
                }
              }
            ]
          }
        }
      },
      "dataset": [],
      "operation": "guarded",
      "args": {
        "n": 12
      },
      "invoker": "did:example:invoker",
      "invocationId": "00000000-0000-4000-8000-000000000004",
      "invokedAt": "2026-11-24T00:00:00.000Z",
      "observe": [
        {
          "entity": "CollectionBlock",
          "fields": ["kind", "title", "slug"],
          "relations": ["children"]
        }
      ],
      "outcome": {
        "error": {
          "class": "precondition",
          "code": "tooBig"
        }
      },
      "records": {
        "CollectionBlock": []
      }
    },
