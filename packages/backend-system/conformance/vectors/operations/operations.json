{
  "version": 1,
  "cases": [
    {
      "id": "create-and-link",
      "note": "creates a board and its columns, and links each column under it",
      "manifest": {
        "version": "1",
        "entities": {},
        "operations": {
          "makeBoard": {
            "description": "A board and a column under it for each column given.",
            "params": {
              "title": {
                "type": "string",
                "required": true
              },
              "columns": {
                "type": "list",
                "required": true
              }
            },
            "steps": [
              {
                "create": {
                  "as": "board",
                  "entity": "CollectionBlock",
                  "fields": {
                    "kind": "board",
                    "title": {
                      "$": "title"
                    }
                  }
                }
              },
              {
                "forEach": {
                  "in": {
                    "$": "columns"
                  },
                  "as": "col",
                  "steps": [
                    {
                      "create": {
                        "as": "column",
                        "entity": "CollectionBlock",
                        "fields": {
                          "kind": "column",
                          "title": {
                            "$": "col.title"
                          }
                        }
                      }
                    },
                    {
                      "link": {
                        "entity": "CollectionBlock",
                        "id": {
                          "$": "board.id"
                        },
                        "relation": "children",
                        "target": {
                          "$": "column.id"
                        }
                      }
                    }
                  ]
                }
              }
            ],
            "returns": {
              "$": "board.id"
            }
          }
        }
      },
      "dataset": [],
      "operation": "makeBoard",
      "args": {
        "title": "Plan",
        "columns": [
          {
            "key": "todo",
            "title": "To do"
          },
          {
            "key": "done",
            "title": "Done"
          }
        ]
      },
      "invoker": "did:example:invoker",
      "invocationId": "00000000-0000-4000-8000-000000000001",
      "invokedAt": "2026-11-24T00:00:00.000Z",
      "observe": [
        {
          "entity": "CollectionBlock",
          "fields": ["kind", "title", "slug"],
          "relations": ["children"]
        }
      ],
      "outcome": {
        "result": "urn:uuid:30198dab-4163-8c59-abb3-e132517aa975"
      },
      "records": {
        "CollectionBlock": [
          {
            "id": "urn:uuid:01b39ce5-8a65-8ff1-8585-d297b052740d",
            "kind": "column",
            "title": "To do"
          },
          {
            "id": "urn:uuid:30198dab-4163-8c59-abb3-e132517aa975",
            "kind": "board",
            "title": "Plan",
            "children": [
              "urn:uuid:01b39ce5-8a65-8ff1-8585-d297b052740d",
              "urn:uuid:b5aaccfb-347d-82b8-844c-ed58404febc5"
            ]
          },
          {
            "id": "urn:uuid:b5aaccfb-347d-82b8-844c-ed58404febc5",
            "kind": "column",
            "title": "Done"
          }
        ]
      }
