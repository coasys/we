{
  "name": "@we/backend-ad4m",
  "version": "0.1.0",
  "description": "The AD4M implementation of WE's backend contract — query adapter, ephemeral port, identity, SDNA install",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:classes": "tsx scripts/generateClasses.mjs"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@we/backend-shared": "workspace:*",
    "@we/entities": "workspace:*"
  },
  "peerDependencies": {
    "@coasys/ad4m": "*"
  },
  "devDependencies": {
    "@coasys/ad4m": "0.13.0-test-interpretation-2",
    "@types/node": "^26.4.0",
    "@we/cli": "workspace:*",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11",
    "tsx": "^4.23.13"
  },
  "sideEffects": false
}
