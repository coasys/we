{
  "name": "@we/template-cartridges",
  "version": "0.1.0",
  "description": "Cartridges: whole apps as data — chrome, space templates, sections, theme, brand and data model — built into a deployment by its seed or installed from a file",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixture": "tsx scripts/fixture.ts",
    "bundle": "tsx scripts/bundle.ts"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "dependencies": {
    "@we/schema-shared": "workspace:*",
    "@we/template-fixtures": "workspace:*",
    "@we/template-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "3.9.10",
    "vitest": "^5.0.5",
    "tsx": "^4.23.15"
  }
}
