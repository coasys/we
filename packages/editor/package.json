{
  "name": "@we/editor",
  "version": "0.1.0",
  "description": "WE's template and theme editing surface — embeddable in any application that satisfies the EditorHost port",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./ai": {
      "import": "./src/ai/index.ts",
      "types": "./src/ai/index.ts"
    },
    "./runtime": {
      "import": "./src/runtime.ts",
      "types": "./src/runtime.ts"
    }
  },
  "dependencies": {
    "@we/design-utils": "workspace:*",
    "@we/schema-shared": "workspace:*"
  },
  "peerDependencies": {
    "@we/components": "workspace:*",
    "@we/schema-solid": "workspace:*",
    "solid-js": "^1.9.15",
    "@we/primitives": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@we/components": "workspace:*",
    "@we/schema-solid": "workspace:*",
    "solid-js": "^1.9.15",
    "@we/primitives": "workspace:*",
    "vitest": "^4.1.11"
  }
}
