{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "composite": false,
    // Experimental decorators needed for models
    "experimentalDecorators": true,
    // The tests build a base64 data URI with `Buffer`, and TypeScript 6 defaults `types` to [] rather
    // than auto-loading every @types package it can find. `src` itself uses no node builtin.
    "types": ["node"]
  },
  "include": ["src", "tests", "scripts", "*.config.ts"]
}
