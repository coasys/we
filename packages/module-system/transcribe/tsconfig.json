{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // `@we/schema-kit` is exported as source, like every in-repo package a bundler compiles rather
    // than links, so typechecking this module also typechecks the kit's own `./x.ts` imports.
    // `@we/module-call` and the template packages already carry this pair for the same reason.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // The VAD worklet uses AudioWorkletProcessor/sampleRate, which live in the DOM's worklet scope
    // rather than the window one — but it ships as a source string, so nothing here needs those libs.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*", "*.config.ts"]
}
