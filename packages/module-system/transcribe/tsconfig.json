{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // The VAD worklet uses AudioWorkletProcessor/sampleRate, which live in the DOM's worklet scope
    // rather than the window one — but it ships as a source string, so nothing here needs those libs.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*"]
}
