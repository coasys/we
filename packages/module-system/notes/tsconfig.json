{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // `@we/schema-kit` is exported as source, like every in-repo package a bundler compiles
    // rather than links, so typechecking this module also typechecks the kit's own `./x.ts`
    // imports. `@we/module-call` and the template packages already carry this pair.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*", "*.config.ts"]
}
