{
  "name": "@we/globe-layers",
  "version": "0.1.0",
  "description": "WE's first-party globe layers — implementations of @we/globe-protocol",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./maplibre": {
      "types": "./dist/maplibre.d.ts",
      "import": "./dist/maplibre.js"
    },
    "./vite": {
      "types": "./vite-plugin.d.mts",
      "import": "./vite-plugin.mjs"
    }
  },
  "files": [
    "dist",
    "assets",
    "vite-plugin.mjs",
    "vite-plugin.d.mts"
  ],
  "keywords": [
    "cesium",
    "globe",
    "layers",
    "h3",
    "geospatial",
    "3d",
    "maps"
  ],
  "dependencies": {
    "@we/globe-core": "workspace:*",
    "h3-js": "^4.1.0",
    "maplibre-gl": "^6.12.0"
  },
  "peerDependencies": {
    "@we/globe-protocol": "workspace:*",
    "cesium": "^1.144.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@we/cli": "workspace:*",
    "@we/globe-protocol": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.2"
  }
}
