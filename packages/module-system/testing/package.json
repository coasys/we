{
  "name": "@we/module-testing",
  "version": "0.1.0",
  "description": "Test a WE feature module without a host — fake deps, an in-memory records kernel, and the contract's own lint",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:steps": "tsup",
    "build": "we-build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@we/backend-shared": "workspace:*",
    "@we/module-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@we/cli": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
