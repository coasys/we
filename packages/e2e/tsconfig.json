{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node"]
  },
  // The declarations are hand-written beside each module, as `@we/csp`'s are: the modules run as
  // they are, with no build, so node:test and vitest import them directly. This checks that the
  // declarations hold together and that what they import exists.
  "include": ["src/**/*.d.mts"]
}
